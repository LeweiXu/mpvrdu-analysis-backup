{"blocks": [{"bbox": [0.0, 0.0, 636.0, 709.0], "text": "", "type": "Page"}, {"bbox": [100.306640625, 83.43212890625, 320.794921875, 101.62200927734375], "text": "Removing the door trim", "type": "SectionHeader"}, {"bbox": [98.75390625, 106.97314453125, 177.01171875, 120.23541259765625], "text": "Drop-in trim", "type": "SectionHeader"}, {"bbox": [99.685546875, 122.55175781250001, 220.798828125, 134.61517333984375], "text": "To remove the trim piece:", "type": "SectionHeader"}, {"bbox": [98.443359375, 137.091796875, 290.9778137207031, 173.25518798828125], "text": "", "type": "ListGroup"}, {"bbox": [100.306640625, 137.091796875, 254.73741149902344, 148.05517578125], "text": "1. Remove all items from the shelf.", "type": "ListItem"}, {"bbox": [98.443359375, 150.939453125, 290.9778137207031, 173.25518798828125], "text": "2. Pull straight up on the trim piece at each end.", "type": "ListItem"}, {"bbox": [98.75390625, 190.4052734375, 219.24609375, 202.05514526367188], "text": "To replace the trim piece:", "type": "SectionHeader"}, {"bbox": [97.201171875, 204.9453125, 290.9778747558594, 265.4151611328125], "text": "", "type": "ListGroup"}, {"bbox": [99.064453125, 204.9453125, 289.0579833984375, 227.10156250000003], "text": "1. Locate each end of the trim piece above the trim pocket opening.", "type": "ListItem"}, {"bbox": [99.375, 229.52490234375003, 290.9778747558594, 251.73513793945312], "text": "2. Push the trim piece straight down until it stops.", "type": "ListItem"}, {"bbox": [97.201171875, 254.79687500000003, 231.69712829589844, 265.4151611328125], "text": "3. Replace items on the shelf.", "type": "ListItem"}, {"bbox": [99.99609375, 270.029296875, 189.43359375, 283.43536376953125], "text": "Snap-on trivet", "type": "SectionHeader"}, {"bbox": [98.443359375, 286.30029296875, 197.197265625, 298.0551452636719], "text": "To remove the trivet:", "type": "SectionHeader"}, {"bbox": [98.1328125, 300.494140625, 278.7379455566406, 338.3751525878906], "text": "", "type": "ListGroup"}, {"bbox": [99.064453125, 300.494140625, 253.5373992919922, 311.4951477050781], "text": "1. Remove all items from the shelf.", "type": "ListItem"}, {"bbox": [98.443359375, 314.341796875, 278.7379455566406, 324.9351501464844], "text": "2. Pull out on the inside tab at each end.", "type": "ListItem"}, {"bbox": [98.1328125, 326.45849609375, 204.57672119140625, 338.3751525878906], "text": "3. Lift trivet straight out.", "type": "ListItem"}, {"bbox": [98.443359375, 379.42578125, 195.955078125, 389.9751281738281], "text": "To replace the trivet:", "type": "SectionHeader"}, {"bbox": [96.580078125, 392.92724609375, 286.8978271484375, 453.5751647949219], "text": "", "type": "ListGroup"}, {"bbox": [98.443359375, 392.92724609375, 286.8978271484375, 415.1751403808594], "text": "1. Line up ends of the trivet with the button on the door liner wall.", "type": "ListItem"}, {"bbox": [98.1328125, 417.85302734375, 274.65777587890625, 440.1351623535156], "text": "2. Push trivet straight back until it snaps securely into place.", "type": "ListItem"}, {"bbox": [96.580078125, 444.16357421875006, 230.25709533691406, 453.5751647949219], "text": "3. Replace items on the shelf.", "type": "ListItem"}, {"bbox": [307.634765625, 118.22436523437501, 455.068359375, 190.578369140625], "text": "", "type": "Picture"}, {"bbox": [310.613037109375, 190.578369140625, 452.090087890625, 252.54663085937503], "text": "", "type": "Picture"}, {"bbox": [314.2734375, 290.45458984375, 422.34375, 383.92626953125], "text": "", "type": "Picture"}, {"bbox": [310.236328125, 377.00244140625, 417.685546875, 473.24365234375006], "text": "", "type": "Picture"}, {"bbox": [96.26953125, 493.66894531250006, 432.90234375, 511.67089843750006], "text": "Adjusting the wine rack (on some models)", "type": "SectionHeader"}, {"bbox": [95.337890625, 515.1328125, 216.451171875, 525.8151397705078], "text": "To remove the wine rack:", "type": "SectionHeader"}, {"bbox": [95.337890625, 528.98046875, 220.593017578125, 566.1351318359375], "text": "", "type": "ListGroup"}, {"bbox": [97.822265625, 528.98046875, 205.2970733642578, 539.01513671875], "text": "1. Lift front of wine rack.", "type": "ListItem"}, {"bbox": [96.580078125, 541.78955078125, 220.177734375, 552.6951446533203], "text": "2. Pull rack off rear-support.", "type": "ListItem"}, {"bbox": [95.337890625, 557.3681640625, 220.593017578125, 566.1351318359375], "text": "3. Replace in reverse order.", "type": "ListItem"}, {"bbox": [305.80712890625006, 511.67089843750006, 433.29443359374994, 601.6806640625], "text": "", "type": "Picture"}, {"bbox": [504.638671875, 678.18896484375, 511.470703125, 685.80517578125], "text": "", "type": "PageFooter"}], "doc_id": "owners-manual-2170416.pdf", "page_index": 9, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/owners-manual-2170416.pdf", "source": "marker"}
e": "TableCell"}, {"bbox": [352.73549987792967, 529.5374781799317, 547.2581439208984, 547.5995967102051], "text": "0 20 40 60 80 100", "type": "TableCell"}, {"bbox": [230.994140625, 556.875, 541.3916625976562, 585.7299346923828], "text": "Note: Respondents who gave other responses or who did not give an answer are not shown. Source: Survey of U.S. adults conducted July 11-Aug. 10, 2017. \"Women and Men in STEM Often at Odds Over Workplace Equity\"", "type": "Text"}, {"bbox": [232.25, 590.51953125, 317.9081726074219, 600.0399475097656], "text": "PEW RESEARCH CENTER", "type": "SectionHeader"}, {"bbox": [264.1640625, 746.7207145690918, 347.8359375, 755.7207145690918], "text": "", "type": "PageFooter"}], "doc_id": "PS_2018.01.09_STEM_FINAL.pdf", "page_index": 8, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/PS_2018.01.09_STEM_FINAL.pdf", "source": "marker"}
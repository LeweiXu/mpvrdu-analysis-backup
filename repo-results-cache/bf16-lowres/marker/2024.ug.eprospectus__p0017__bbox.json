{"blocks": [{"bbox": [0.0, 0.0, 1191.0, 842.0], "text": "", "type": "Page"}, {"bbox": [0.0, 0.0, 633.30029296875, 842.0], "text": "", "type": "Picture"}, {"bbox": [633.30029296875, 24.08642578125, 653.07275390625, 43.33935546875], "text": "", "type": "Picture"}, {"bbox": [633.8818359375, 50.98046875, 683.25, 62.4921875], "text": "ABOUT", "type": "SectionHeader"}, {"bbox": [633.30029296875, 69.72929652715939, 786.0, 209.2666015625], "text": "The National Institute of Education (NIE), Singapore, is the national teacher education institute and an integral part of the nation's education system. Offering multidisciplinary undergraduate and graduate programmes, the institute empowers you to analyse, tackle, and resolve challenges in various career pathways, both within and beyond the realm of education.", "type": "Text"}, {"bbox": [635.044921875, 237.6794300979519, 731.25, 262.4220837043633], "text": "OUR PROGRAMMES", "type": "SectionHeader"}, {"bbox": [637.5, 268.880859375, 759.0, 278.91718610863757], "text": "\u2022 Double Major Programme", "type": "Text"}, {"bbox": [644.349609375, 287.9145146927872, 729.75, 297.66162065894923], "text": "Bachelor of Arts in", "type": "SectionHeader"}, {"bbox": [643.76806640625, 300.5380859375, 783.75, 452.11576135351737], "text": "", "type": "ListGroup"}, {"bbox": [644.349609375, 300.5380859375, 731.25, 309.6580587711487], "text": "Art and Education", "type": "ListItem"}, {"bbox": [645.0, 312.4609375, 783.75, 323.1540516473731], "text": "Chinese Studies and Education", "type": "ListItem"}, {"bbox": [643.76806640625, 326.8505859375, 747.0, 336.6500445235975], "text": "Drama and Education", "type": "ListItem"}, {"bbox": [645.75, 339.6491540516474, 763.5, 363.0302734375], "text": "English Language &amp; Linguistics and Education", "type": "ListItem"}, {"bbox": [645.75, 365.0859375, 750.0, 387.6349065004452], "text": "English Literature and Education", "type": "ListItem"}, {"bbox": [645.75, 392.13357079252, 763.5, 402.63045414069455], "text": "Geography and Education", "type": "ListItem"}, {"bbox": [644.349609375, 404.1300089047195, 747.75, 414.62689225289404], "text": "History and Education", "type": "ListItem"}, {"bbox": [645.0, 417.6260017809439, 775.5, 427.37310774710596], "text": "Malay Studies and Education", "type": "ListItem"}, {"bbox": [645.0, 430.4560546875, 741.75, 440.1193232413179], "text": "Music and Education", "type": "ListItem"}, {"bbox": [645.75, 441.9677734375, 774.03369140625, 452.11576135351737], "text": "Tamil Studies and Education", "type": "ListItem"}, {"bbox": [645.0, 462.61264470169186, 744.0, 472.3916015625], "text": "Bachelor of Science in", "type": "SectionHeader"}, {"bbox": [637.5, 474.447265625, 783.0, 621.5654496883348], "text": "", "type": "ListGroup"}, {"bbox": [645.0, 474.447265625, 750.0, 485.1059661620659], "text": "Biology and Education", "type": "ListItem"}, {"bbox": [645.75, 488.8548530721282, 761.23974609375, 499.115234375], "text": "Chemistry and Education", "type": "ListItem"}, {"bbox": [645.75, 501.1708984375, 771.0, 521.8450578806768], "text": "Food &amp; Consumer Sciences", "type": "ListItem"}, {"bbox": [645.75, 527.093499554764, 783.0, 550.3365983971505], "text": "Mathematics &amp; Computational Thinking and Education", "type": "ListItem"}, {"bbox": [645.75, 553.3357079252004, 778.5, 574.763671875], "text": "Physics &amp; Energy Studies and Education", "type": "ListItem"}, {"bbox": [644.93115234375, 578.8281389136242, 774.75, 589.1533203125], "text": "Sport Science and Education", "type": "ListItem"}, {"bbox": [637.5, 598.3223508459483, 769.5, 621.5654496883348], "text": "Bachelor of Science in Sport Science &amp; Management", "type": "ListItem"}, {"bbox": [636.75, 651.5565449688335, 771.75, 662.8032056990205], "text": "CAREER PROSPECTS", "type": "SectionHeader"}, {"bbox": [636.0, 671.0507569011576, 783.0, 719.786286731968], "text": "Graduates of NIE's Double Major Programmes are passionate young people who have a calling to be professional leaders in education.", "type": "Text"}, {"bbox": [636.0, 734.6943359375, 782.7568359375, 797.7631344612645], "text": "SSM graduates can pursue careers ranging from sport administrators, event managers, writers and marketers, to sport scientists, trainers and coaches.", "type": "Text"}, {"bbox": [828.0, 41.935546875, 1092.0, 65.2306322350846], "text": "NATIONAL INSTITUTE OF EDUCATION (NIE) DOUBLE MAJOR PROGRAMME", "type": "SectionHeader"}, {"bbox": [1118.132666015625, 37.5775390625, 1147.558740234375, 61.0943359375], "text": "", "type": "Picture"}, {"bbox": [824.6279296875, 73.47818343722173, 1149.0, 122.21371326803205], "text": "NIE equips students with the skills, knowledge and values needed to grow into inspiring educators. Our emphasis on cutting-edge research and provision of global immersion opportunities will prepare you to better adapt to an everevolving educational landscape.", "type": "Text"}, {"bbox": [837.0, 142.45770258236865, 957.75, 153.70436331255564], "text": "OUR ADVANTAGES", "type": "SectionHeader"}, {"bbox": [836.782177734375, 168.60556640625, 863.649462890625, 194.83583984375], "text": "", "type": "Picture"}, {"bbox": [870.56982421875, 169.38671875, 966.0, 200.6328125], "text": "Ranked 11th in QS World University Rankings 2023 in the field of Education", "type": "Text"}, {"bbox": [981.702685546875, 170.7845703125, 1018.805126953125, 194.3013671875], "text": "", "type": "Picture"}, {"bbox": [1018.86328125, 168.564453125, 1140.0, 211.43722172751558], "text": "Offers deep content knowledge and strong inquiry skills to prepare students for the Education profession", "type": "Text"}, {"bbox": [833.176611328125, 224.60185546875, 862.602685546875, 249.02314453125], "text": "", "type": "Picture"}, {"bbox": [867.662109375, 224.93321460373997, 969.0, 270.525390625], "text": "Over 70 years of providing initial teacher preparation and continual teacher professional development", "type": "Text"}, {"bbox": [990.94921875, 224.0673828125, 1021.189453125, 247.9130859375], "text": "", "type": "Picture"}, {"bbox": [1018.86328125, 224.93321460373997, 1122.0, 279.1591796875], "text": "Multiple pathways for professional advancement to cater to the diversity of applicants' educational backgrounds", "type": "Text"}, {"bbox": [828.0, 325.4033837934105, 1072.5, 337.951171875], "text": "SPORT SCIENCE &amp; MANAGEMENT (SSM)", "type": "SectionHeader"}, {"bbox": [1113.247705078125, 323.35595703125, 1147.791357421875, 345.96826171875], "text": "", "type": "Picture"}, {"bbox": [828.0, 348.646482635797, 1140.75, 410.12822796081923], "text": "SSM is the only full-time undergraduate programme offered by a local tertiary institute that prepares students for sport-related careers. Under this multifaceted four-year programme, you will learn exercise physiology, sport biomechanics, motor skill acquisition, sport psychology, sport management and coaching, on top of other valuable skills.", "type": "Text"}, {"bbox": [837.0, 425.873552983081, 957.75, 437.86999109528045], "text": "OUR ADVANTAGES", "type": "SectionHeader"}, {"bbox": [831.897216796875, 451.21826171875, 863.882080078125, 482.87548828125], "text": "", "type": "Picture"}, {"bbox": [869.40673828125, 455.53515625, 975.24755859375, 486.78125], "text": "Hands-on practical experiences, guest lectures and soft skills development", "type": "Text"}, {"bbox": [986.820263671875, 457.22080078125, 1013.687548828125, 483.45107421875], "text": "", "type": "Picture"}, {"bbox": [1020.75, 455.8646482635797, 1134.75, 496.3526268922529], "text": "State-of-the-art sport science laboratories and teaching facilities, and highly-qualified academic staff", "type": "Text"}, {"bbox": [838.061572265625, 500.3486328125, 862.370068359375, 527.4833984375], "text": "", "type": "Picture"}, {"bbox": [868.24365234375, 503.10062333036507, 973.5, 535.294921875], "text": "Opportunity for overseas study and living experience for up to six months", "type": "Text"}, {"bbox": [905.46240234375, 535.294921875, 922.90869140625, 558.318359375], "text": "", "type": "Picture"}, {"bbox": [870.75, 550.095703125, 962.45361328125, 593.073909171861], "text": "Ranked 5 &lt;sup&gt;th&lt;/sup&gt; in Asia in the QS World University Rankings 2023 in Sportrelated subjects", "type": "Text"}, {"bbox": [991.53076171875, 510.626953125, 1015.95556640625, 532.005859375], "text": "", "type": "Picture"}, {"bbox": [1015.3740234375, 511.44921875, 1139.25, 554.20703125], "text": "Internship opportunities with major sport-related employers in Singapore and the Asia-Pacific region", "type": "Text"}, {"bbox": [825.20947265625, 633.966796875, 842.65576171875, 643.833984375], "text": "\\alpha", "type": "SectionHeader"}, {"bbox": [828.0, 654.5234375, 1139.25, 773.0204808548531], "text": "The NIE faculty and facilities have been instrumental in shaping my university experience. The cutting-edge laboratories provide top-notch resources that enhance the quality of my education. Collaborating with dedicated peers who share a passion for our field of study makes my time at college substantially more rewarding. The combination of excellent facilities and a supportive community at NIE have significantly enriched my academic journey.\"", "type": "Text"}, {"bbox": [836.2587890625, 779.9189453125, 985.5, 800.0124666073018], "text": "\u2013 RUTH KOH Sport Science &amp; Management, Year 3", "type": "Text"}, {"bbox": [1136.25, 805.8203125, 1152.0, 817.2573463935886], "text": "", "type": "PageFooter"}], "doc_id": "2024.ug.eprospectus.pdf", "page_index": 17, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/2024.ug.eprospectus.pdf", "source": "marker"}
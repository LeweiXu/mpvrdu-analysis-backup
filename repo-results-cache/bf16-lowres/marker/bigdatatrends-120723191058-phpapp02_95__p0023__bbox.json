{"blocks": [{"bbox": [0.0, 0.0, 768.0, 576.0], "text": "", "type": "Page"}, {"bbox": [24.0, 22.5, 313.5, 57.375], "text": "The Big Data Cycle", "type": "SectionHeader"}, {"bbox": [25.875, 147.375, 300.75, 313.875], "text": "Consumer scale and speed requirements have introduced new technologies that have increased the efficiency of using Big Data", "type": "Text"}, {"bbox": [316.4625, 133.453125, 507.0375, 198.421875], "text": "", "type": "Picture"}, {"bbox": [438.0, 236.8125, 739.5, 350.4375], "text": "This increased efficiency is leading to adoption of Big Data across a wide variety of industries", "type": "Text"}, {"bbox": [83.55, 354.54375, 225.45, 474.58125], "text": "", "type": "Picture"}, {"bbox": [252.375, 381.9375, 495.0, 493.5], "text": "This results in the generation and consumption of more data", "type": "Text"}, {"bbox": [506.175, 378.84375, 672.825, 484.03125], "text": "", "type": "Picture"}, {"bbox": [27.75, 544.78125, 217.875, 558.84375], "text": "", "type": "PageFooter"}, {"bbox": [719.25, 545.625, 735.0, 556.875], "text": "", "type": "PageFooter"}], "doc_id": "bigdatatrends-120723191058-phpapp02_95.pdf", "page_index": 23, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/bigdatatrends-120723191058-phpapp02_95.pdf", "source": "marker"}
{"blocks": [{"bbox": [0.0, 0.0, 638.0, 711.0], "text": "", "type": "Page"}, {"bbox": [118.37890625, 76.376953125, 200.62109375, 89.09515380859375], "text": "To reinstall shelf:", "type": "SectionHeader"}, {"bbox": [117.1328125, 89.5693359375, 297.81640625, 166.13519287109375], "text": "", "type": "ListGroup"}, {"bbox": [119.3134765625, 89.5693359375, 255.45726013183594, 102.775146484375], "text": "1. Hold shelf at front and back.", "type": "ListItem"}, {"bbox": [118.0673828125, 104.150390625, 293.37591552734375, 127.4952392578125], "text": "2. Tilt front of shelf up to a 45\" angle to track.", "type": "ListItem"}, {"bbox": [117.4443359375, 128.10498046875, 297.6959228515625, 152.4552001953125], "text": "3. Insert both rear shelf slides into upper channel of track.", "type": "ListItem"}, {"bbox": [117.1328125, 153.4482421875, 297.81640625, 166.13519287109375], "text": "4. Lower front of shelf to a level position.", "type": "ListItem"}, {"bbox": [117.4443359375, 169.41796875, 312.8161926269531, 206.21517944335938], "text": "NOTE: Make sure both rear shelf slides are securely in the track before letting go of shelf.", "type": "Text"}, {"bbox": [318.15888671875, 66.58681640625, 535.41533203125, 205.59287109375], "text": "", "type": "Picture"}, {"bbox": [117.1328125, 215.244140625, 483.484375, 236.10205078125], "text": "Removing the crisper and crisper cover", "type": "SectionHeader"}, {"bbox": [117.1328125, 238.8515625, 224.296875, 251.57513427734375], "text": "To remove the crisper:", "type": "SectionHeader"}, {"bbox": [117.1328125, 251.69677734375, 307.5378112792969, 305.57513427734375], "text": "", "type": "ListGroup"}, {"bbox": [118.37890625, 251.69677734375, 307.5378112792969, 265.01513671875], "text": "1. Slide the crisper straight out to the stop.", "type": "ListItem"}, {"bbox": [117.755859375, 265.236328125, 217.443359375, 278.45513916015625], "text": "2. Lift the front slightly.", "type": "ListItem"}, {"bbox": [118.6904296875, 278.77587890625, 256.89727783203125, 292.1351318359375], "text": "3. Slide out the rest of the way.", "type": "ListItem"}, {"bbox": [117.1328125, 293.35693359375, 242.97679138183594, 305.57513427734375], "text": "4. Replace in reverse order.", "type": "ListItem"}, {"bbox": [327.81103515625, 234.685546875, 470.93505859375, 373.552734375], "text": "", "type": "Picture"}, {"bbox": [473.5200500488281, 244.75341796875, 524.7086791992188, 299.15478515625], "text": "Pull out to the stop, lift the front, and pull again.", "type": "Text"}, {"bbox": [117.755859375, 364.5263671875, 165.74765014648438, 377.5953674316406], "text": "Style 1", "type": "SectionHeader"}, {"bbox": [118.0673828125, 379.107421875, 218.3779296875, 391.73516845703125], "text": "To remove the cover:", "type": "SectionHeader"}, {"bbox": [118.6904296875, 392.64697265625, 311.85791015625, 430.1351623535156], "text": "", "type": "ListGroup"}, {"bbox": [119.625, 392.64697265625, 311.85791015625, 416.6951599121094], "text": "1. Hold cover firmly with both hands and lift front of cover off supports.", "type": "ListItem"}, {"bbox": [118.6904296875, 418.6845703125, 286.4175109863281, 430.1351623535156], "text": "2. Lift cover out by pulling up and out.", "type": "ListItem"}, {"bbox": [117.755859375, 435.69580078125, 218.689453125, 447.6551818847656], "text": "To replace the cover:", "type": "SectionHeader"}, {"bbox": [118.37890625, 448.541015625, 306.81793212890625, 486.05516052246094], "text": "", "type": "ListGroup"}, {"bbox": [119.001953125, 448.541015625, 306.81793212890625, 472.85516357421875], "text": "1. Fit back of cover into notch supports on walls of refrigerator.", "type": "ListItem"}, {"bbox": [118.37890625, 474.2314453125, 228.3369598388672, 486.05516052246094], "text": "2. Lower front into place.", "type": "ListItem"}, {"bbox": [327.62919921875, 376.087060546875, 473.60908203125, 511.274267578125], "text": "", "type": "Picture"}, {"bbox": [474.4801025390625, 442.63916015625, 517.2686157226562, 483.60498046875], "text": "Lift the cover front, then the back.", "type": "Text"}, {"bbox": [117.755859375, 516.93310546875, 164.30767822265625, 531.1953582763672], "text": "Style 2", "type": "SectionHeader"}, {"bbox": [117.755859375, 533.25, 217.443359375, 545.3351440429688], "text": "To remove the cover:", "type": "SectionHeader"}, {"bbox": [118.37890625, 546.4423828125, 295.29779052734375, 597.415153503418], "text": "", "type": "ListGroup"}, {"bbox": [119.001953125, 546.4423828125, 295.29779052734375, 570.2951354980469], "text": "1. Push up glass insert from the bottom, then slide out with both hands.", "type": "ListItem"}, {"bbox": [118.6904296875, 572.47998046875, 235.29725646972656, 583.9751510620117], "text": "2. Lift front of cover frame.", "type": "ListItem"}, {"bbox": [118.37890625, 585.3251953125, 252.57708740234375, 597.415153503418], "text": "3. Lift cover frame up and out.", "type": "ListItem"}, {"bbox": [117.1328125, 603.3779296875, 216.8203125, 614.6951522827148], "text": "To replace the cover:", "type": "SectionHeader"}, {"bbox": [115.263671875, 615.8759765625, 310.8981018066406, 675.8951644897461], "text": "", "type": "ListGroup"}, {"bbox": [118.0673828125, 615.8759765625, 305.6180725097656, 650.9351577758789], "text": "1. Fit back of cover frame into notch supports on walls of refrigerator, then lower front into place.", "type": "ListItem"}, {"bbox": [115.263671875, 651.287109375, 310.8981018066406, 675.8951644897461], "text": "2. Slide back of glass insert into place, then lower front into place.", "type": "ListItem"}, {"bbox": [325.4796875, 522.69609375, 484.48125, 647.954296875], "text": "", "type": "Picture"}, {"bbox": [117.4443359375, 672.1171875, 130.8957061767578, 684.2951583862305], "text": "", "type": "PageFooter"}], "doc_id": "owners-manual-2170416.pdf", "page_index": 12, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/owners-manual-2170416.pdf", "source": "marker"}
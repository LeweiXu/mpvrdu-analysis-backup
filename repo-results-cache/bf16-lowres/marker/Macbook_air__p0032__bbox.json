{"blocks": [{"bbox": [0.0, 0.0, 354.0, 354.0], "text": "", "type": "Page"}, {"bbox": [37.3359375, 27.71002197265625, 320.6221618652344, 48.3984375], "text": "\u00c2 Two-finger scrolling lets you drag to scroll quickly up, down, or sideways in the active window. This option is on by default.", "type": "Text"}, {"bbox": [41.830078125, 51.3369140625, 125.490234375, 131.1943359375], "text": "", "type": "Picture"}, {"bbox": [38.71875, 135.169921875, 324.2313537597656, 154.64501953125], "text": "The following trackpad gestures work in certain applications, such as Preview or iPhoto. For more information, choose Help &gt; Mac Help and search for \"trackpad.\"", "type": "Text"}, {"bbox": [38.373046875, 158.37722778320312, 302.56060791015625, 167.64501953125], "text": "\u00c2 Two-finger pinching lets you zoom in or out on PDFs, images, photos, and more.", "type": "Text"}, {"bbox": [40.1015625, 170.44892578125, 131.3671875, 249.92607421875], "text": "", "type": "Picture"}, {"bbox": [154.46015625, 175.0640625, 247.246875, 248.0765625], "text": "", "type": "Picture"}, {"bbox": [203.2734375, 329.6279296875, 335.9759826660156, 337.25160217285156], "text": "", "type": "PageFooter"}, {"bbox": [328.072265625, 330.837890625, 335.677734375, 334.986328125], "text": "", "type": "PageFooter"}], "doc_id": "Macbook_air.pdf", "page_index": 32, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/Macbook_air.pdf", "source": "marker"}
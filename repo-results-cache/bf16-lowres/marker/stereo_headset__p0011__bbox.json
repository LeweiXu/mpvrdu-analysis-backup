{"blocks": [{"bbox": [0.0, 0.0, 595.0, 842.0], "text": "", "type": "Page"}, {"bbox": [34.20709991455078, 29.6015625, 308.65350341796875, 40.907958984375], "text": "Noise canceling function microphones (internal) (left, right) 10.", "type": "Text"}, {"bbox": [53.10491180419922, 43.1689453125, 374.7610778808594, 54.18353271484375], "text": "Pick up the sound of the noise when the noise canceling function is in use.", "type": "Text"}, {"bbox": [34.20709991455078, 56.94927978515625, 173.2162628173828, 81.42694091796875], "text": "", "type": "ListGroup"}, {"bbox": [34.2822265625, 56.94927978515625, 95.17530059814453, 67.918701171875], "text": "11. Right unit", "type": "ListItem"}, {"bbox": [34.20709991455078, 70.3037109375, 173.2162628173828, 81.42694091796875], "text": "Touch sensor control panel 12.", "type": "ListItem"}, {"bbox": [52.58544921875, 84.693359375, 530.227783203125, 107.4576416015625], "text": "Remotely controls music playback of the connected Bluetooth device or performs other operations using touch operation.", "type": "Text"}, {"bbox": [34.20709991455078, 110.2259521484375, 126.79779815673828, 121.19537353515625], "text": "CUSTOM button 13.", "type": "Text"}, {"bbox": [53.10491180419922, 124.5732421875, 417.5710144042969, 134.470947265625], "text": "Operate when switching the noise canceling function and Ambient Sound Mode, etc.", "type": "Text"}, {"bbox": [33.701171875, 137.238525390625, 138.52162170410156, 148.20794677734375], "text": "Indicator (red/blue) 14.", "type": "Text"}, {"bbox": [53.10491180419922, 151.7080078125, 421.3360595703125, 161.4835205078125], "text": "Lights up in red or blue to indicate the power or communication status of the headset.", "type": "Text"}, {"bbox": [33.1201171875, 164.0419921875, 159.1226348876953, 188.7266845703125], "text": "", "type": "ListGroup"}, {"bbox": [33.41064453125, 164.0419921875, 135.85435485839844, 175.21954345703125], "text": "15. (power) button", "type": "ListItem"}, {"bbox": [33.1201171875, 177.75726318359375, 159.1226348876953, 188.7266845703125], "text": "Charging indicator (red) 16.", "type": "ListItem"}, {"bbox": [51.42333984375, 191.9990234375, 188.38356018066406, 202.00225830078125], "text": "Lights up in red while charging.", "type": "Text"}, {"bbox": [33.1201171875, 204.01947021484375, 130.36392211914062, 214.9888916015625], "text": "USB Type-C port 17.", "type": "Text"}, {"bbox": [51.42333984375, 218.51055908203125, 559.8303833007812, 241.76983642578125], "text": "Connect the headset to an AC outlet via a commercially available USB AC adaptor or to a computer with the supplied USB Type-C cable to charge the headset.", "type": "Text"}, {"bbox": [32.5390625, 244.53839111328125, 177.03001403808594, 255.5078125], "text": "Headphone cable input jack 18.", "type": "Text"}, {"bbox": [52.294921875, 258.6025390625, 557.8717651367188, 282.28875732421875], "text": "Connect a music player, etc. using the supplied headphone cable. Make sure that you insert the cable until it clicks. If the plug is not connected correctly, you may not hear the sound properly.", "type": "Text"}, {"bbox": [33.701171875, 284.9150390625, 169.9761505126953, 296.026611328125], "text": "Voice pickup microphones 19.", "type": "Text"}, {"bbox": [52.58544921875, 298.8935546875, 439.46099853515625, 309.30218505859375], "text": "Pick up the sound of your voice when talking on the phone or in the Speak-to-Chat mode.", "type": "Text"}, {"bbox": [31.9580078125, 311.3193359375, 128.75799560546875, 322.28875732421875], "text": "Proximity sensor 20.", "type": "Text"}, {"bbox": [52.00439453125, 324.794921875, 265.83929443359375, 335.5643005371094], "text": "Detects whether the headset is worn on the ears.", "type": "Text"}, {"bbox": [36.31591796875, 377.8310546875, 102.22250366210938, 388.0887145996094], "text": "Related Topic", "type": "SectionHeader"}, {"bbox": [41.54541015625, 394.6875, 220.45492553710938, 422.6025085449219], "text": "", "type": "ListGroup"}, {"bbox": [41.54541015625, 394.6875, 133.5553436279297, 405.3456115722656], "text": "About the indicator", "type": "ListItem"}, {"bbox": [41.54541015625, 412.8486022949219, 220.45492553710938, 422.6025085449219], "text": "Checking the remaining battery charge", "type": "ListItem"}, {"bbox": [214.430419921875, 455.53515625, 382.8663635253906, 465.6993408203125], "text": "5-013-731-11(7) Copyright 2020 Sony Corporation", "type": "Text"}, {"bbox": [292.8515625, 817.7431640625, 301.9264831542969, 828.3435668945312], "text": "", "type": "PageFooter"}], "doc_id": "stereo_headset.pdf", "page_index": 11, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/stereo_headset.pdf", "source": "marker"}
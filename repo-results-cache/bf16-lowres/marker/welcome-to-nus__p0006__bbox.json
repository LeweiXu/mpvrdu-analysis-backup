{"blocks": [{"bbox": [0.0, 0.0, 879.0, 695.0], "text": "", "type": "Page"}, {"bbox": [34.01570129394531, 32.91748046875, 166.33822631835938, 84.2030029296875], "text": "DISCOVER NUS", "type": "SectionHeader"}, {"bbox": [33.4775390625, 106.5576171875, 152.1857147216797, 123.4498291015625], "text": "SEMESTER TWO", "type": "SectionHeader"}, {"bbox": [31.7607421875, 134.384765625, 81.87580108642578, 146.75933837890625], "text": "JANUARY", "type": "SectionHeader"}, {"bbox": [32.619140625, 157.12158203125, 112.23785400390625, 168.134765625], "text": "GO GLOBAL FAIR", "type": "SectionHeader"}, {"bbox": [33.4775390625, 170.01708984375, 231.6822967529297, 207.01382446289062], "text": "Look up the exciting overseas opportunities, including exchange and international summer programmes, that NUS has to offer.", "type": "Text"}, {"bbox": [33.90673828125, 220.5810546875, 140.00479125976562, 233.26321411132812], "text": "JANUARY/FEBRUARY", "type": "SectionHeader"}, {"bbox": [33.4775390625, 243.31787109375, 94.45479583740234, 254.63870239257812], "text": "CAREER FEST", "type": "SectionHeader"}, {"bbox": [32.18994140625, 255.53466796875, 225.5261688232422, 280.521728515625], "text": "Interact and network with potential employers to get a head start in your career planning.", "type": "Text"}, {"bbox": [235.887890625, 106.08251953125, 409.627734375, 265.85107421875], "text": "", "type": "Picture"}, {"bbox": [22.2587890625, 289.47021484375, 410.3740234375, 476.11572265625], "text": "", "type": "Picture"}, {"bbox": [31.171875, 476.11572265625, 406.611328125, 645.11474609375], "text": "", "type": "Picture"}, {"bbox": [469.5439453125, 32.91748046875, 653.2412109375, 167.98095703125], "text": "", "type": "Picture"}, {"bbox": [523.19384765625, 154.40673828125, 541.22021484375, 175.44677734375], "text": "", "type": "SectionHeader"}, {"bbox": [473.3858642578125, 201.5771484375, 522.576904296875, 213.23269653320312], "text": "OPEN DAY", "type": "SectionHeader"}, {"bbox": [473.3858642578125, 181.8572998046875, 511.70587158203125, 191.8572998046875], "text": "MARCH", "type": "Text"}, {"bbox": [470.40234375, 214.13330078125, 637.2418212890625, 239.11572265625], "text": "Find out everything you need to know about learning and living in NUS.", "type": "Text"}, {"bbox": [473.3858642578125, 253.49853515625, 563.5503540039062, 265.2261962890625], "text": "NUS ARTS FESTIVAL", "type": "SectionHeader"}, {"bbox": [472.119140625, 265.71533203125, 639.245361328125, 317.1011962890625], "text": "Organised by NUS Centre For the Arts, this festival brings campus and professional artists together to explore a contemporary theme each year.", "type": "Text"}, {"bbox": [473.3857727050781, 330.87158203125, 497.0126953125, 343.84161376953125], "text": "JULY", "type": "SectionHeader"}, {"bbox": [473.3857727050781, 354.62646484375, 578.77880859375, 365.2170104980469], "text": "NUS COMMENCEMENT", "type": "SectionHeader"}, {"bbox": [472.54833984375, 366.50390625, 638.552734375, 417.092041015625], "text": "Celebrate with the graduating cohort as they mark the completion of their degrees and the beginning of the next chapter in their lives.", "type": "Text"}, {"bbox": [657.8427734375, 30.5419921875, 847.7880859375, 174.4287109375], "text": "", "type": "Picture"}, {"bbox": [670.83837890625, 174.4287109375, 846.81005859375, 416.0498046875], "text": "", "type": "Picture"}, {"bbox": [551.091796875, 447.2705078125, 774.2891845703125, 472.99078369140625], "text": "Look out for these other events which are regularly held throughout the year:", "type": "SectionHeader"}, {"bbox": [521.434130859375, 482.8349609375, 560.147900390625, 521.6572265625], "text": "", "type": "Picture"}, {"bbox": [503.3418884277344, 530.0732421875, 581.868896484375, 540.6009674072266], "text": "Academic events", "type": "SectionHeader"}, {"bbox": [498.12542724609375, 542.62939453125, 586.9124145507812, 592.5087127685547], "text": "like symposiums, talks and forums featuring prominent speakers.", "type": "Text"}, {"bbox": [633.498046875, 479.203857421875, 671.267578125, 515.786376953125], "text": "", "type": "Picture"}, {"bbox": [600.87890625, 528.7158203125, 708.8724365234375, 605.5047149658203], "text": "Bazaars , carnivals and fairs with stalls offering a range of items, from clothing and accessories to food and electronic items.", "type": "Text"}, {"bbox": [751.484912109375, 481.61328125, 790.198681640625, 517.44921875], "text": "", "type": "Picture"}, {"bbox": [717.19189453125, 528.037109375, 830.3603515625, 631.5007133483887], "text": "Arts and music lovers can look forward to a wide range of exhibitions , performances , concerts and recitals organised by NUS Centre For the Arts and NUS Yong Siew Toh Conservatory of Music.", "type": "Text"}, {"bbox": [36.0, 663.779296875, 844.23486328125, 673.4073295593262], "text": "10 11", "type": "Text"}], "doc_id": "welcome-to-nus.pdf", "page_index": 6, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/welcome-to-nus.pdf", "source": "marker"}
{"blocks": [{"bbox": [0.0, 0.0, 612.0, 792.0], "text": "", "type": "Page"}, {"bbox": [70.5234375, 42.92578125, 219.9609832763672, 53.772216796875], "text": "", "type": "PageHeader"}, {"bbox": [465.8394775390625, 42.92578125, 564.75146484375, 53.28021240234375], "text": "", "type": "PageHeader"}, {"bbox": [71.71875, 98.10577392578125, 480.35174560546875, 164.10577392578125], "text": "Universal display platform for all connected home devices.", "type": "SectionHeader"}, {"bbox": [70.224609375, 178.27734375, 337.1070251464844, 272.9752197265625], "text": "Zips Connected Home display solution is the first and only universal and cost-effective platform to curate, display, and protect Internet of Things (IoT) and connected home devices. The platform provides a clean and consistent display solution that accommodates a wide range of devices in varying shapes and sizes to meet any retailer's unique merchandising and security needs.", "type": "Text"}, {"bbox": [69.626953125, 287.02265625, 559.222900390625, 444.84710693359375], "text": "", "type": "PictureGroup"}, {"bbox": [109.191796875, 287.02265625, 310.362890625, 421.44609375], "text": "", "type": "Picture"}, {"bbox": [69.626953125, 433.0971374511719, 559.222900390625, 444.84710693359375], "text": "Vertical display mount shown without merchandise Connected Home device plugged into Zips", "type": "Caption"}, {"bbox": [336.427734375, 281.53125, 567.228515625, 458.047119140625], "text": "", "type": "PictureGroup"}, {"bbox": [336.427734375, 281.53125, 567.228515625, 433.125], "text": "", "type": "Picture"}, {"bbox": [350.525390625, 433.125, 553.130859375, 458.047119140625], "text": "Multiport", "type": "Caption"}, {"bbox": [70.5234375, 483.36346435546875, 162.28799438476562, 501.36346435546875], "text": "At a glance:", "type": "SectionHeader"}, {"bbox": [72.9140625, 517.04296875, 192.1095428466797, 527.0704956054688], "text": "FEATURES AND BENEFITS", "type": "SectionHeader"}, {"bbox": [70.822265625, 546.046875, 528.5989990234375, 613.7252197265625], "text": "", "type": "ListGroup"}, {"bbox": [71.419921875, 546.046875, 281.9339904785156, 571.7252197265625], "text": "\u203a Universal, modular design complements the device and provides versatility", "type": "ListItem"}, {"bbox": [70.822265625, 575.7252197265625, 289.4119873046875, 585.7252197265625], "text": "\u203a Compact design is ideal when space is limited", "type": "ListItem"}, {"bbox": [71.12109375, 588.97265625, 296.343994140625, 613.7252197265625], "text": "\u203a Powered option allows user interaction with the device", "type": "ListItem"}, {"bbox": [323.033203125, 546.8203125, 527.7659912109375, 571.7252197265625], "text": "\u203a When used with Zips, you can power up to 4 positions", "type": "ListItem"}, {"bbox": [320.94140625, 575.4375, 528.5989990234375, 599.7252197265625], "text": "\u203a Alarm units can be mounted under counter for a clean display (not shown)", "type": "ListItem"}, {"bbox": [526.833984375, 754.48828125, 540.0030517578125, 764.9752368927002], "text": "", "type": "PageFooter"}, {"bbox": [71.71875, 761.0625, 225.93055725097656, 770.34375], "text": "", "type": "PageFooter"}], "doc_id": "2021-Apple-Catalog.pdf", "page_index": 36, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/2021-Apple-Catalog.pdf", "source": "marker"}
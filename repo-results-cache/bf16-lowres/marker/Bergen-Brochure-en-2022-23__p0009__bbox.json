{"blocks": [{"bbox": [0.0, 0.0, 840.0, 596.0], "text": "", "type": "Page"}, {"bbox": [22.6802978515625, 14.841796875, 228.4183349609375, 30.39630126953125], "text": "Chapter 2.1 Attractions Visit Bergen Bergen Guide 2022", "type": "Text"}, {"bbox": [24.19921875, 40.16015625, 233.4930419921875, 56.25616455078125], "text": "STOREBL\u00c5 AQUACULTURE VISITOR CENTRE 9", "type": "SectionHeader"}, {"bbox": [21.328125, 62.568359375, 283.1962890625, 104.57232666015625], "text": "A different kind of experience marked by know-how and action! Storebl\u00e5 Aquaculture Visitor Centre provides a unique, comprehensive insight into Norwegian aquaculture. Explore and learn more about this industry in our modern exhibition and see salmon up close on a bracing RIB boat trip to a fish farm outside Bergen.", "type": "Text"}, {"bbox": [22.677200317382812, 127.173828125, 227.7702178955078, 134.57083129882812], "text": "Sandviksboder 1G / NO-5035 / + 47 53 00 61 90 / storebla.no", "type": "Text"}, {"bbox": [21.328125, 139.10546875, 47.578125, 157.73046875], "text": "", "type": "Picture"}, {"bbox": [40.1953125, 139.6875, 64.8046875, 155.37060546875], "text": "", "type": "Picture"}, {"bbox": [24.914062499999996, 158.719921875, 88.2890625, 175.366015625], "text": "", "type": "Picture"}, {"bbox": [40.535400390625, 183.11056518554688, 95.17340087890625, 191.61056518554688], "text": "ULRIKEN643", "type": "Text"}, {"bbox": [20.91796875, 196.7265625, 277.489501953125, 239.9266357421875], "text": "Experience the mountains in the middle of the city! Take the cable car up to the top of Bergen where you'll find a fantastic landscape, views, activities and unique culinary experiences in Skyskraperen Restaurant. The Ulriken Express Bus service runs from the city centre to the cable car every half hour from 1 May to 30 September.", "type": "Text"}, {"bbox": [21.73828125, 261.623046875, 250.2395477294922, 269.9251708984375], "text": "Haukelandsbakken 40 / NO-5009 / +47 53 64 36 43 / ulriken643.no", "type": "Text"}, {"bbox": [18.45703125, 273.845703125, 42.24609375, 294.216796875], "text": "", "type": "Picture"}, {"bbox": [34.86328125, 274.13671875, 53.73046874999999, 291.59765625], "text": "", "type": "Picture"}, {"bbox": [54.55078124999999, 275.30078125, 76.69921875, 290.43359375], "text": "", "type": "Picture"}, {"bbox": [64.8046875, 274.427734375, 84.4921875, 291.306640625], "text": "", "type": "Picture"}, {"bbox": [40.535400390625, 310.8046875, 164.8828125, 326.9649353027344], "text": "VESTKANTEN EXPERIENCES", "type": "SectionHeader"}, {"bbox": [22.55859375, 332.33984375, 280.41375732421875, 366.7835388183594], "text": "Vestkanten is the biggest shopping and activity centre in Norway. The centre has a water park complex, a spa section, bowling, minigolf, skating, curling, shops and restaurants \u2013 just 10 minutes from the centre of Bergen. Unforgettable experiences await at Vestkanten!", "type": "Text"}, {"bbox": [20.91796875, 378.611328125, 252.99826049804688, 405.9212341308594], "text": "Vestkanten Storsenter / +47 55 50 77 77 (Water park and ice rink) / +47 55 50 77 80 (bowling and minigolf) / Loddefjord / NO-5171 / vestkantenopplevelser.no", "type": "Text"}, {"bbox": [18.78515625, 408.876953125, 38.63671875, 428.083984375], "text": "", "type": "Picture"}, {"bbox": [38.96484375, 410.041015625, 56.19140624999999, 426.919921875], "text": "", "type": "Picture"}, {"bbox": [41.8359375, 410.041015625, 59.88281249999999, 426.919921875], "text": "", "type": "Picture"}, {"bbox": [56.60156249999999, 410.33203125, 79.5703125, 427.79296875], "text": "", "type": "Picture"}, {"bbox": [36.09375, 450.783203125, 196.87499999999997, 462.31919860839844], "text": "BERGEN SCIENCE CENTRE \u2013 VILVITE", "type": "SectionHeader"}, {"bbox": [21.328125, 468.826171875, 283.51953125, 510.6353530883789], "text": "Explore science and technology with all your senses! The main exhibition is full of interesting experiences for children and adults alike. Go on a voyage of discovery through the body, learn about the cycle of nature, cycle a 360-degree loop, do experiments with water, take part in a creative workshop, see a science show and lots more.", "type": "Text"}, {"bbox": [21.328125, 533.6338310241699, 274.5441589355469, 540.70703125], "text": "Thorm\u00f8hlens gate 51, M\u00f8hlenpris / NO-5006 / + 47 55 59 45 00 / vilvite.no", "type": "Text"}, {"bbox": [22.1484375, 544.78125, 56.60156249999999, 562.2421875], "text": "", "type": "Picture"}, {"bbox": [41.8359375, 547.982421875, 68.0859375, 563.697265625], "text": "", "type": "Picture"}, {"bbox": [59.88281249999999, 547.440616607666, 96.27389526367188, 566.607421875], "text": "", "type": "Picture"}, {"bbox": [294.943359375, 36.3478515625, 384.275390625, 165.0349609375], "text": "", "type": "Picture"}, {"bbox": [294.533203125, 165.122265625, 392.88867187499994, 297.010546875], "text": "", "type": "Picture"}, {"bbox": [298.18359375, 306.73046875, 384.31640625, 427.79296875], "text": "", "type": "Picture"}, {"bbox": [298.18359375, 312.841796875, 385.95703125, 427.501953125], "text": "", "type": "Picture"}, {"bbox": [289.98046875, 442.1400390625, 389.23828125, 568.2662109375], "text": "", "type": "Picture"}, {"bbox": [449.69531249999994, 13.0083984375, 482.17968749999994, 30.39630126953125], "text": "", "type": "Picture"}, {"bbox": [538.890869140625, 14.893798828125, 573.88623046875, 30.39630126953125], "text": "Bergen Guide 2022", "type": "Text"}, {"bbox": [624.23583984375, 13.38671875, 660.76171875, 30.39630126953125], "text": "Chapter 2.1 Attractions", "type": "Text"}, {"bbox": [453.63281249999994, 43.65234375, 551.2080688476562, 59.0908203125], "text": "ESCAPE BRYGGEN 13", "type": "SectionHeader"}, {"bbox": [453.22265624999994, 64.60546875, 715.2540893554688, 98.90948486328125], "text": "Escape Bryggen is Norway's oldest Escape Room company, and the only one in the whole world in a UNESCO World Heritage site. You get 60 minutes to: Escape from the curse, Disarm the bomb, Catch the murderer, Escape Bryggen!", "type": "Text"}, {"bbox": [451.99218749999994, 98.36328125, 708.4981079101562, 115.90447998046875], "text": "With four rooms, both indoors and outdoors, we have something to suit everyone! Perfect for families, tourists and everyone else!", "type": "Text"}, {"bbox": [452.40234374999994, 126.591796875, 656.6966552734375, 134.57083129882812], "text": "Bryggen 35 / NO-5003 / +47 4737 2273 / escapebryggen.no", "type": "Text"}, {"bbox": [450.14648437499994, 138.5525390625, 481.72851562499994, 157.1193359375], "text": "", "type": "Picture"}, {"bbox": [724.74609375, 35.0091796875, 824.0039062499999, 167.5376953125], "text": "", "type": "Picture"}, {"bbox": [453.5433044433594, 181.01171875, 577.7177124023438, 197.0272216796875], "text": "Explanation symbols:", "type": "SectionHeader"}, {"bbox": [448.71093749999994, 206.912109375, 471.67968749999994, 222.626953125], "text": "", "type": "Text"}, {"bbox": [470.55120849609375, 213.314453125, 536.8511962890625, 223.36972045898438], "text": "Wheelchair access", "type": "Text"}, {"bbox": [550.4296875, 208.25078125, 568.4765625, 223.61640625], "text": "", "type": "Picture"}, {"bbox": [580.37109375, 209.240234375, 597.59765625, 220.298828125], "text": "", "type": "Text"}, {"bbox": [572.03369140625, 212.732421875, 670.0130004882812, 223.36972045898438], "text": "Caf\u00e9 Open all year", "type": "Text"}, {"bbox": [447.80859374999994, 232.637890625, 467.66015624999994, 249.283984375], "text": "", "type": "Picture"}, {"bbox": [470.55120849609375, 240.669921875, 505.03619384765625, 249.23721313476562], "text": "Shopping", "type": "Text"}, {"bbox": [549.240234375, 234.383984375, 566.384765625, 251.030078125], "text": "", "type": "Picture"}, {"bbox": [568.06640625, 238.341796875, 616.9962158203125, 249.23721313476562], "text": "Bergen Card", "type": "Text"}, {"bbox": [451.66406249999994, 273.321875, 476.92968749999994, 291.2484375], "text": "", "type": "Picture"}, {"bbox": [488.08593749999994, 276.46484375, 507.77343749999994, 288.10546875], "text": "", "type": "Text"}, {"bbox": [525.8267822265625, 275.8828125, 699.9527587890625, 294.4536437988281], "text": "Look for the in the Bergen Guide to find ecolabel tourism enterprises in the region.", "type": "Text"}, {"bbox": [445.67578124999994, 455.4370422363281, 692.91796875, 537.4530372619629], "text": "", "type": "Picture"}, {"bbox": [448.30078124999994, 551.18359375, 647.388916015625, 564.7647972106934], "text": "More information: visitBergen.com", "type": "Text"}, {"bbox": [22.677200317382812, 572.71875, 816.378173828125, 581.3182649612427], "text": "26 27", "type": "Text"}], "doc_id": "Bergen-Brochure-en-2022-23.pdf", "page_index": 9, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/Bergen-Brochure-en-2022-23.pdf", "source": "marker"}
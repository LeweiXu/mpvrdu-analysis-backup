{"blocks": [{"bbox": [0.0, 0.0, 612.0, 792.0], "text": "", "type": "Page"}, {"bbox": [421.048828125, 42.65521240234375, 540.0087890625, 52.65521240234375], "text": "", "type": "PageHeader"}, {"bbox": [71.419921875, 43.3125, 135.1110076904297, 53.39715576171875], "text": "", "type": "PageHeader"}, {"bbox": [72.017578125, 98.10577392578125, 225.40432739257812, 128.10577392578125], "text": "Series 2865", "type": "SectionHeader"}, {"bbox": [70.822265625, 160.48828125, 321.0490417480469, 310.9752502441406], "text": "Series 2865 is a flexible, multi-position security system that allows retailers to secure multiple electronics and accessories on a single fixture or display. Designed for single applications, mixed use tables and branded ecosystems, the S2865 is a modular, smart voltage regulation system with multi-voltage power boxes and a full portfolio of sensors that can be configured to accommodate different needs. The Ultra Low Profile sensors and low pull recoiler deliver a great consumer experience in a clean, modern design ensuring the product is the hero.", "type": "Text"}, {"bbox": [38.84765625, 309.375, 361.880859375, 431.4923400878906], "text": "", "type": "PictureGroup"}, {"bbox": [42.134765625, 309.375, 361.880859375, 403.734375], "text": "", "type": "Picture"}, {"bbox": [38.84765625, 419.4923400878906, 358.80731201171875, 431.4923400878906], "text": "Series 2865 split-counter view of Macbook and iPhone display", "type": "Caption"}, {"bbox": [357.943359375, 93.160546875, 569.0789794921875, 256.484619140625], "text": "", "type": "PictureGroup"}, {"bbox": [357.943359375, 93.160546875, 568.423828125, 230.136328125], "text": "", "type": "Picture"}, {"bbox": [399.234375, 232.03125, 569.0789794921875, 256.484619140625], "text": "iPad Pro and Magic Keyboard with custom dual sensor", "type": "Caption"}, {"bbox": [376.86419677734375, 286.55859375, 582.2529296875, 490.22210693359375], "text": "", "type": "PictureGroup"}, {"bbox": [443.98828125, 286.55859375, 542.14453125, 479.14453125], "text": "", "type": "Picture"}, {"bbox": [376.86419677734375, 479.14453125, 582.2529296875, 490.22210693359375], "text": "iPhone Xs on a Series 2865 Vertical Display", "type": "Caption"}, {"bbox": [70.5234375, 470.1134033203125, 162.28799438476562, 488.8125], "text": "At a glance:", "type": "SectionHeader"}, {"bbox": [72.0, 505.44140625, 190.65234375, 516.0704956054688], "text": "FEATURES AND BENEFITS", "type": "SectionHeader"}, {"bbox": [70.224609375, 524.390625, 572.6849975585938, 604.9752197265625], "text": "", "type": "ListGroup"}, {"bbox": [71.12109375, 524.77734375, 291.7060241699219, 548.9752197265625], "text": "\u203a Designed for branded ecosystems, mixed-use displays and category specific displays", "type": "ListItem"}, {"bbox": [70.5234375, 552.62109375, 305.9190368652344, 576.9752197265625], "text": "\u203a Quick disconnect feature for customer interaction and easy nightly removal", "type": "ListItem"}, {"bbox": [70.224609375, 580.9752197265625, 294.5010070800781, 604.9752197265625], "text": "\u203a Ultra Low Profile sensor makes the product the hero and delivers a great customer experience", "type": "ListItem"}, {"bbox": [313.470703125, 524.390625, 572.2589721679688, 548.9752197265625], "text": "\u203a Smart voltage regulation compensates for voltage loss between the Power Box and device", "type": "ListItem"}, {"bbox": [313.171875, 552.62109375, 551.60498046875, 576.9752197265625], "text": "\u203a Up to 24 powered and 24 alarming positions or 48 alarming only positions", "type": "ListItem"}, {"bbox": [313.76953125, 580.9752197265625, 572.6849975585938, 604.9752197265625], "text": "\u203a Under counter components are future-proof and easily remerchandised for the addition of new products", "type": "ListItem"}, {"bbox": [34.365234375, 626.87109375, 107.22688293457031, 637.0704803466797], "text": "COMPATIBILITY", "type": "SectionHeader"}, {"bbox": [11.63671875, 672.03984375, 602.75390625, 741.80390625], "text": "", "type": "Picture"}, {"bbox": [532.212890625, 754.48828125, 540.0, 764.9752368927002], "text": "", "type": "PageFooter"}, {"bbox": [71.419921875, 761.0777015686035, 211.869140625, 770.0777015686035], "text": "", "type": "PageFooter"}], "doc_id": "2021-Apple-Catalog.pdf", "page_index": 8, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/2021-Apple-Catalog.pdf", "source": "marker"}
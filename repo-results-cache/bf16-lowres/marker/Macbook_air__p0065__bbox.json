{"blocks": [{"bbox": [0.0, 0.0, 354.0, 354.0], "text": "", "type": "Page"}, {"bbox": [39.064453125, 28.693359375, 154.74398803710938, 43.19219970703125], "text": "Responsible party (contact for FCC matters only): Apple Inc. Corporate Compliance", "type": "Text"}, {"bbox": [39.5830078125, 45.19195556640625, 102.55122375488281, 59.1917724609375], "text": "1 Infinite Loop M/S 26-A Cupertino, CA 95014-2084", "type": "Text"}, {"bbox": [38.8916015625, 64.58563232421875, 94.99151611328125, 71.58563232421875], "text": "Wireless Radio Use", "type": "SectionHeader"}, {"bbox": [38.71875, 72.251953125, 178.03311157226562, 86.771484375], "text": "This device is restricted to indoor use when operating in the 5.15 to 5.25 GHz frequency band.", "type": "Text"}, {"bbox": [39.064453125, 90.57421875, 136.94442749023438, 96.796875], "text": "Cet appareil doit \u00eatre utilis\u00e9 \u00e0 l'int\u00e9rieur.", "type": "Text"}, {"bbox": [38.5458984375, 102.08563232421875, 147.84637451171875, 109.08563232421875], "text": "Exposure to Radio Frequency Energy", "type": "SectionHeader"}, {"bbox": [39.755859375, 110.1923828125, 174.72402954101562, 148.19158935546875], "text": "The radiated output power of the AirPort Extreme technology is below the FCC radio frequency exposure limits. Nevertheless, it is advised to use the wireless equipment in such a manner that the potential for human contact during normal operation is minimized.", "type": "Text"}, {"bbox": [39.755859375, 153.4921875, 144.849609375, 160.58563232421875], "text": "FCC Bluetooth Wireless Compliance", "type": "SectionHeader"}, {"bbox": [39.064453125, 161.6923828125, 174.54470825195312, 191.6917724609375], "text": "The antenna used with this transmitter must not be collocated or operated in conjunction with any other antenna or transmitter subject to the conditions of the FCC Grant.", "type": "Text"}, {"bbox": [38.2001953125, 196.359375, 151.2451171875, 204.08563232421875], "text": "Bluetooth Industry Canada Statement", "type": "SectionHeader"}, {"bbox": [38.5458984375, 203.4462890625, 172.51727294921875, 219.19216918945312], "text": "This Class B device meets all requirements of the Canadian interference-causing equipment regulations.", "type": "Text"}, {"bbox": [38.373046875, 222.4599609375, 177.28897094726562, 245.19198608398438], "text": "Cet appareil num\u00e9rique de la Class B respecte toutes les exigences du R\u00e8glement sur le mat\u00e9riel brouilleur du Canada.", "type": "Text"}, {"bbox": [37.8544921875, 250.2890625, 120.26220703125, 257.58563232421875], "text": "Industry Canada Statement", "type": "SectionHeader"}, {"bbox": [38.2001953125, 257.3759765625, 176.29598999023438, 288.6917724609375], "text": "Complies with the Canadian ICES-003 Class B specifications. Cet appareil num\u00e9rique de la classe B est conforme \u00e0 la norme NMB-003 du Canada. This device complies with RSS 210 of Industry Canada.", "type": "Text"}, {"bbox": [37.8544921875, 293.15625, 153.748779296875, 301.08563232421875], "text": "Europe\u2014EU Declaration of Conformity", "type": "SectionHeader"}, {"bbox": [37.3359375, 301.2802734375, 135.515625, 308.1923828125], "text": "See: www.apple.com/euro/compliance", "type": "Text"}, {"bbox": [184.60546875, 29.0390625, 237.9700927734375, 36.0855712890625], "text": "Korea Statements", "type": "SectionHeader"}, {"bbox": [185.296875, 39.064453125, 322.88671875, 51.509765625], "text": "", "type": "Text"}, {"bbox": [203.1005859375, 55.3125, 294.0205078125, 61.53515625], "text": "", "type": "Text"}, {"bbox": [187.025390625, 63.609375, 312.861328125, 73.98046875], "text": "", "type": "Text"}, {"bbox": [184.60546875, 80.58526611328125, 279.5227966308594, 87.58526611328125], "text": "Singapore Wireless Certification", "type": "SectionHeader"}, {"bbox": [189.9638671875, 92.4755859375, 220.0400390625, 107.3408203125], "text": "", "type": "Text"}, {"bbox": [186.0, 116.5855712890625, 267.3323059082031, 123.5855712890625], "text": "Taiwan Wireless Statements", "type": "Sectio
{"blocks": [{"bbox": [0.0, 0.0, 628.0, 703.0], "text": "", "type": "Page"}, {"bbox": [111.6171875, 38.4453125, 404.765625, 70.51611328125], "text": "Food Storage Guide", "type": "SectionHeader"}, {"bbox": [110.697265625, 75.17431640625, 489.46038818359375, 101.25518798828125], "text": "There is a correct way to package and store refrigerated or frozen food. To keep food fresher, longer, take the time to study these recommended steps.", "type": "Text"}, {"bbox": [111.310546875, 128.03662109375, 281.189453125, 147.94580078125], "text": "Storing fresh food", "type": "SectionHeader"}, {"bbox": [111.310546875, 150.69189453125, 295.53790283203125, 220.53512573242188], "text": "Wrap or store food in the refrigerator in air-tight and moisture-proof material. This prevents food odor and taste transfer throughout the refrigerator. For dated products, check code date to ensure freshness.", "type": "Text"}, {"bbox": [112.84375, 231.70166015625, 219.5546875, 244.74560546875], "text": "Leafy vegetables", "type": "SectionHeader"}, {"bbox": [112.84375, 246.11865234375, 305.1380615234375, 292.295166015625], "text": "Remove store wrapping and trim or tear off bruised and discolored areas. Wash in cold water and drain. Place in plastic bag or plastic container and store in crisper.", "type": "Text"}, {"bbox": [112.84375, 303.443359375, 251.4453125, 328.55535888671875], "text": "Vegetables with skins (carrots, peppers)", "type": "SectionHeader"}, {"bbox": [113.763671875, 328.8447265625, 284.0179138183594, 353.2551574707031], "text": "Store in crisper, plastic bags, or plastic container.", "type": "Text"}, {"bbox": [113.45703125, 364.88720703125, 144.12109375, 377.515380859375], "text": "Fruit", "type": "SectionHeader"}, {"bbox": [113.150390625, 378.61767578125, 306.5779724121094, 448.0551452636719], "text": "Wash, let dry, and store in refrigerator in plastic bags or crisper. Do not wash or hull berries until they are ready to use. Sort and keep berries in their original container in a crisper, or store in a loosely closed paper bag on a refrigerator shelf.", "type": "Text"}, {"bbox": [114.990234375, 459.62744140625, 145.041015625, 474.21514892578125], "text": "bw", "type": "SectionHeader"}, {"bbox": [114.68359375, 474.04443359375, 306.02734375, 497.01513671875], "text": "Store without washing in the original carton on interior shelf.", "type": "Text"}, {"bbox": [113.45703125, 509.74365234375, 140.44140625, 521.2753601074219], "text": "Milk", "type": "SectionHeader"}, {"bbox": [114.0703125, 523.130859375, 301.734375, 545.9751434326172], "text": "Wipe milk cartons. For best storage, place milk on interior shelf.", "type": "Text"}, {"bbox": [114.376953125, 557.11376953125, 240.099609375, 571.53076171875], "text": "Butter or margarine", "type": "SectionHeader"}, {"bbox": [114.0703125, 570.84423828125, 288.2421875, 617.4951553344727], "text": "Keep opened butter in covered dish or closed compartment. When storing an extra supply, wrap in freezer packaging and freeze.", "type": "Text"}, {"bbox": [328.10546875, 150.69189453125, 373.48828125, 164.39532470703125], "text": "Cheese", "type": "SectionHeader"}, {"bbox": [326.87890625, 164.42236328125, 521.90234375, 200.3751220703125], "text": "Store in the original wrapping until you are ready to use it. Once opened, rewrap tightly in plastic wrap or aluminum foil.", "type": "Text"}, {"bbox": [326.87890625, 211.44921875, 388.20703125, 224.8753662109375], "text": "Leftovers", "type": "SectionHeader"}, {"bbox": [329.025390625, 225.52294921875, 527.858154296875, 261.09515380859375], "text": "Cover leftovers with plastic wrap or aluminum foil. Plastic containers with tight lids can also be used.", "type": "Text"}, {"bbox": [328.412109375, 272.5498046875, 360.916015625, 285.3553771972656], "text": "Meat", "type": "SectionHeader"}, {"bbox": [328.10546875, 285.93701171875, 527.6179809570312, 332.85516357421875], "text": "Store most meat in original wrapping as long as it is airtight and moisture-proof. Rewrap if necessary. See the following chart for storage times.", "type": "Text"}, {"bbox": [329.33203125, 332.27734375, 525.58203125, 499.89512634277344], "text": "", "type": "TableGroup"}, {"bbox": [327.36953125, 330.86310546875, 527.54453125, 475.11541015625], "text": "TYPE APPROXIMATE TIME (DAYS)+ Chicken 1 to2 Ground beef 1 to2 Steaks and roasts 3 to 5 Cured meats 7to 10 Bacon 5 to 7 Cold cuts 3 to 5 Variety meats 1 to 2", "type": "Table"}, {"bbox": [332.2085949160448, 335.08327945963543, 418.2852728544776, 363.36461246744796], "text": "TYPE", "type": "TableCell"}, {"bbox": [418.18751399253733, 335.08327945963543, 525.4289855410448, 363.36461246744796], "text": "APPROXIMATE TIME (DAYS)+", "type": "TableCell"}, {"bbox": [332.2085949160448, 363.4218799641927, 418.2852728544776, 379.2893817545573], "text": "Chicken", "type": "TableCell"}, {"bbox": [418.18751399253733, 363.4218799641927, 525.3312266791045, 379.2893817545573], "text": "1 to2", "type": "TableCell"}, {"bbox": [332.74626865671644, 379.09995849609373, 418.2852728544776, 394.3419230143229], "text": "Ground beef", "type": "TableCell"}, {"bbox": [418.18751399253733, 379.09995849609373, 525.3312266791045, 394.3419230143229], "text": "1 to2", "type": "TableCell"}, {"bbox": [332.7951480876866, 394.3419230143229, 418.2852728544776, 409.6896121419271], "text": "Steaks and roasts", "type": "TableCell"}, {"bbox": [418.18751399253733, 394.3419230143229, 525.4778649720149, 409.6896121419271], "text": "3 to 5", "type": "TableCell"}, {"bbox": [332.64850979477615, 409.6896121419271, 418.2852728544776, 425.14302587890626], "text": "Cured meats", "type": "TableCell"}, {"bbox": [418.18751399253733, 409.6896121419271, 525.4289855410448, 425.14302587890626], "text": "7to 10", "type": "TableCell"}, {"bbox": [332.35523320895527, 425.27077644856774, 418.2852728544776, 440.85634594726565], "text": "Bacon", "type": "TableCell"}, {"bbox": [418.18751399253733, 425.27077644856774, 525.5267444029851, 440.85634594726565], "text": "5 to 7", "type": "TableCell"}, {"bbox": [332.55075093283585, 440.67573307291667, 418.2852728544776, 456.46394140625], "text": "Cold cuts", "type": "TableCell"}, {"bbox": [418.18751399253733, 440.67573307291667, 525.5267444029851, 456.46394140625], "text": "3 to 5", "type": "TableCell"}, {"bbox": [332.35523320895527, 456.17319873046876, 418.2852728544776, 472.40192626953126], "text": "Variety meats", "type": "TableCell"}, {"bbox": [418.18751399253733, 456.17319873046876, 525.5267444029851, 472.40192626953126], "text": "1 to 2", "type": "TableCell"}, {"bbox": [332.84402751865673, 472.36888732910154, 418.2852728544776, 474.965748046875], "text": "", "type": "TableCell"}, {"bbox": [418.18751399253733, 472.36888732910154, 524.0603614738807, 475.0009895833333], "text": "", "type": "TableCell"}, {"bbox": [329.9453125, 475.7607421875, 517.609375, 499.89512634277344], "text": "+ When storing meat longer than the times given, follow the directions for freezing.", "type": "Footnote"}, {"bbox": [330.55859375, 504.93798828125, 528.03515625, 528.96630859375], "text": "NOTE: Use fresh fish and shellfish the same day as purchased.", "type": "Text"}, {"bbox": [112.537109375, 672.1064453125, 126.50904083251953, 682.5351333618164], "text": "", "type": "PageFooter"}], "doc_id": "owners-manual-2170416.pdf", "page_index": 24, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/owners-manual-2170416.pdf", "source": "marker"}
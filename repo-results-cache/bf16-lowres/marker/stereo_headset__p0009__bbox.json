{"blocks": [{"bbox": [0.0, 0.0, 595.0, 842.0], "text": "", "type": "Page"}, {"bbox": [34.86328125, 33.712890625, 73.212890625, 41.935546875], "text": "", "type": "SectionHeader"}, {"bbox": [36.31591796875, 52.21881103515625, 94.85850524902344, 63.47332763671875], "text": "Help Guide", "type": "SectionHeader"}, {"bbox": [36.89697265625, 78.9375, 191.44796752929688, 100.8465576171875], "text": "Wireless Noise Canceling Stereo Headset WH-1000XM4", "type": "Text"}, {"bbox": [36.6064453125, 117.9951171875, 280.3792419433594, 131.2840576171875], "text": "Setting the headset in the carrying case", "type": "SectionHeader"}, {"bbox": [34.86328125, 148.0078125, 549.3929443359375, 171.98321533203125], "text": "When you have finished using the headset, rotate the left and right units to flatten the headset, fold one unit toward the headband, and store them in the supplied carrying case.", "type": "Text"}, {"bbox": [26.54736328125, 184.06416015625, 406.91943359375, 286.27177734375], "text": "", "type": "Picture"}, {"bbox": [37.1875, 293.1376953125, 313.0096130371094, 305.03179931640625], "text": "To store the cables and plug adaptor for in-flight use", "type": "SectionHeader"}, {"bbox": [36.31591796875, 312.4609375, 495.435546875, 322.8092041015625], "text": "Put the cables and plug adaptor for in-flight use in the holder separated by the divider in the carrying case.", "type": "Text"}, {"bbox": [31.89990234375, 328.412890625, 135.44384765625, 429.716015625], "text": "", "type": "Picture"}, {"bbox": [213.2470703125, 470.7470703125, 382.8663635253906, 479.95794677734375], "text": "5-013-731-11(7) Copyright 2020 Sony Corporation", "type": "Text"}, {"bbox": [292.8515625, 817.7431640625, 301.9264831542969, 828.3435668945312], "text": "", "type": "PageFooter"}], "doc_id": "stereo_headset.pdf", "page_index": 9, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/stereo_headset.pdf", "source": "marker"}
{"blocks": [{"bbox": [0.0, 0.0, 624.0, 699.0], "text": "", "type": "Page"}, {"bbox": [93.84375, 77.818359375, 281.53125, 97.14202880859375], "text": "Installing it properly", "type": "SectionHeader"}, {"bbox": [92.625, 98.9794921875, 292.6580505371094, 243.65512084960938], "text": "", "type": "ListGroup"}, {"bbox": [94.1484375, 98.9794921875, 283.29803466796875, 134.45513916015625], "text": "1. Allow 1.25 cm (% inch) space on each side and at the top of the refrigerator for ease of installation.", "type": "ListItem"}, {"bbox": [92.9296875, 135.8408203125, 292.6580505371094, 182.21514892578125], "text": "2. If the hinge side of the refrigerator is to be against a wall, you might want to leave extra space so the door can be opened wider.", "type": "ListItem"}, {"bbox": [92.625, 183.96533203125, 283.77789306640625, 207.17510986328125], "text": "3. The refrigerator can be flush against the back wall.", "type": "ListItem"}, {"bbox": [94.1484375, 208.880859375, 287.3203125, 243.65512084960938], "text": "4. Make sure the ice maker water supply has been connected. Refer to Installation Instructions.", "type": "ListItem"}, {"bbox": [298.56328125, 92.6994140625, 453.40546875, 260.8962890625], "text": "", "type": "Picture"}, {"bbox": [94.7578125, 266.220703125, 190.43492126464844, 285.30206298828125], "text": "Leveling it", "type": "SectionHeader"}, {"bbox": [93.5390625, 289.08837890625, 286.7109375, 334.85516357421875], "text": "Your refrigerator has 2 front leveling screws - one on the right and one on the left. To adjust one or both of these, follow the directions below.", "type": "Text"}, {"bbox": [92.9296875, 336.5302734375, 280.0078125, 414.0551452636719], "text": "", "type": "ListGroup"}, {"bbox": [93.84375, 336.5302734375, 264.577392578125, 348.53515625], "text": "1. Remove base grille. (See page 16.)", "type": "ListItem"}, {"bbox": [92.9296875, 350.865234375, 262.9453125, 361.97515869140625], "text": "2. To raise front, turn screw clockwise.", "type": "ListItem"}, {"bbox": [92.9296875, 363.49365234375, 280.0078125, 386.9351501464844], "text": "3. To lower front, turn screw counterclockwise.", "type": "ListItem"}, {"bbox": [92.9296875, 388.75048828125, 180.33673095703125, 400.6151428222656], "text": "4. Check with level.", "type": "ListItem"}, {"bbox": [93.234375, 403.4267578125, 264.097412109375, 414.0551452636719], "text": "5. Replace base grille. (See page 16.)", "type": "ListItem"}, {"bbox": [296.18671875, 283.2861328125, 516.71953125, 433.4619140625], "text": "", "type": "Picture"}, {"bbox": [501.8203125, 671.0126953125, 508.5234375, 679.2041015625], "text": "", "type": "PageFooter"}], "doc_id": "owners-manual-2170416.pdf", "page_index": 7, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/owners-manual-2170416.pdf", "source": "marker"}
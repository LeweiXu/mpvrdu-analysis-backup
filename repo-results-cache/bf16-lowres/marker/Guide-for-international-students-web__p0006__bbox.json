{"blocks": [{"bbox": [0.0, 0.0, 341.0, 468.0], "text": "", "type": "Page"}, {"bbox": [27.306640625, 22.8515625, 311.81048583984375, 29.78643798828125], "text": "", "type": "PageHeader"}, {"bbox": [309.03125, 23.080078125, 312.361328125, 28.107421875], "text": "", "type": "PageHeader"}, {"bbox": [50.826171875, 48.673828125, 88.37109375, 88.435546875], "text": "", "type": "Figure"}, {"bbox": [43.95703125, 87.85684204101562, 97.904296875, 108.65093994140625], "text": "Top 3", "type": "SectionHeader"}, {"bbox": [41.12646484375, 111.515625, 100.5692138671875, 119.73721313476562], "text": "UK student city", "type": "Text"}, {"bbox": [42.79150390625, 126.369140625, 100.28630065917969, 139.97586059570312], "text": "StudentCrowd user reviews 2021", "type": "Text"}, {"bbox": [127.658544921875, 59.2083984375, 209.345361328125, 78.8150390625], "text": "", "type": "Picture"}, {"bbox": [125.75790405273438, 85.52224731445312, 218.76295471191406, 106.31634521484375], "text": "5-star rating", "type": "SectionHeader"}, {"bbox": [124.03030395507812, 107.859375, 214.7342987060547, 137.109375], "text": "A sign of quality teaching, facilities, and employability prospects", "type": "Text"}, {"bbox": [157.52911376953125, 140.994140625, 181.65576171875, 148.68243408203125], "text": "QS 2022", "type": "Text"}, {"bbox": [249.85576171874996, 46.434375, 284.28876953125, 80.6203125], "text": "", "type": "Picture"}, {"bbox": [249.42285156249997, 87.521484375, 286.92889404296875, 108.46954345703125], "text": "88%", "type": "Text"}, {"bbox": [232.10321044921875, 108.544921875, 306.99920654296875, 134.87060546875], "text": "of NTU students would recommend studying at NTU", "type": "Text"}, {"bbox": [234.41529846191406, 138.251953125, 302.7041015625, 152.71035766601562], "text": "Postgraduate Taught Experience Survey 2023", "type": "Text"}, {"bbox": [74.32734375, 166.862109375, 109.49296875, 196.020703125], "text": "", "type": "Picture"}, {"bbox": [117.63780212402344, 167.958984375, 293.6928405761719, 195.98526000976562], "text": "\"Nothing compares to the pure joy you'll feel when you've got used to your new life here \u2013 you have embarked on one of the best journeys of your life.\"", "type": "Text"}, {"bbox": [116.55273437499999, 201.779296875, 279.7727966308594, 210.66818237304688], "text": "Rucsandra-Ioana Moldoveanu, Romania, 2023", "type": "Text"}, {"bbox": [43.307666015625, 255.9603515625, 75.909130859375, 290.6490234375], "text": "", "type": "Picture"}, {"bbox": [45.45556640625, 293.87109375, 176.5435791015625, 421.8478355407715], "text": "\"I've been able to interact with exceptional students from across the world, use world-class facilities in modern interactive study spaces and participate in exiting events which make for a life-changing experience. NTU offers support, including mental and physical health, the employability team is dedicated to helping students with placements and work, and the Global Lounge is the cherry on top! For me, NTU's assistance started when I landed at Heathrow, and it continues to this day.\"", "type": "Text"}, {"bbox": [45.2890625, 427.552734375, 165.5928192138672, 445.5308074951172], "text": "Muhammad Fahd-Un-Nabi Khan, Pakistan, 2023", "type": "Text"}, {"bbox": [186.51767578125, 260.325, 341.0, 455.3859375], "text": "", "type": "Picture"}], "doc_id": "Guide-for-international-students-web.pdf", "page_index": 6, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/Guide-for-international-students-web.pdf", "source": "marker"}
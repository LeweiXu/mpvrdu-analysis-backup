{"blocks": [{"bbox": [0.0, 0.0, 612.0, 792.0], "text": "", "type": "Page"}, {"bbox": [43.330078125, 40.21875, 114.451171875, 50.3134765625], "text": "", "type": "PageHeader"}, {"bbox": [43.927734375, 69.39691162109375, 399.88201904296875, 135.39691162109375], "text": "Teach your old commute new tricks.", "type": "SectionHeader"}, {"bbox": [41.23828125, 159.71484375, 271.21600341796875, 339.9669494628906], "text": "The 2024 Toyota Camry keeps the convenience of a midsize sedan and delivers a drive that amplifies the fun. With you in mind, Camry comes in a wide range of models, so there's a perfect match for you. Whether giving your adventures a confidence boost with available All-Wheel Drive (AWD) capability or taking your daily commutes as far as they can with hybrid efficiency, there's a Camry fit for your lifestyle.", "type": "Text"}, {"bbox": [296.3478515625, 135.235546875, 581.0115234375, 350.483203125], "text": "", "type": "Picture"}, {"bbox": [27.52031249999999, 350.483203125, 583.284375, 675.0949218750001], "text": "", "type": "Picture"}, {"bbox": [38.9373046875, 709.62890625, 122.4298828125, 735.15234375], "text": "", "type": "Picture"}, {"bbox": [161.72578125, 709.70625, 245.87578125, 733.528125], "text": "", "type": "Picture"}, {"bbox": [284.6337890625, 697.09921875, 327.3662109375, 743.04140625], "text": "", "type": "Picture"}, {"bbox": [362.478515625, 711.5625, 447.943359375, 728.578125], "text": "", "type": "Picture"}, {"bbox": [482.966015625, 711.4078125, 573.690234375, 731.8265625], "text": "", "type": "Picture"}], "doc_id": "camry_ebrochure.pdf", "page_index": 1, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/camry_ebrochure.pdf", "source": "marker"}
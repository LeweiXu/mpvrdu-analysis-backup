{"blocks": [{"bbox": [0.0, 0.0, 465.0, 634.0], "text": "", "type": "Page"}, {"bbox": [34.73876953125, 25.6943359375, 138.0, 33.7431640625], "text": "", "type": "PageHeader"}, {"bbox": [366.41455078125, 16.99541015625, 427.35498046875, 44.91865234375], "text": "", "type": "Picture"}, {"bbox": [34.73876953125, 58.5087890625, 171.0, 66.69739952718676], "text": "FPROM CHARACTERISTICS", "type": "SectionHeader"}, {"bbox": [158.02734375, 74.94089834515366, 301.5234375, 83.2744140625], "text": "Table 3. EPROM Programming Modes", "type": "Text"}, {"bbox": [31.755322265625, 81.8380078125, 428.703662109375, 133.6229296875], "text": "Table 6: El From 1 Togramming modes Mode RST PSEN ALE EA P2.7 P2.6 P2.5 P2.4 Program 1 0 0* VPP 1 0 \u0425 \u0425 Verify 1 0 1 1 0 0 \u0425 \u0425 Security Set 1 0 0* VPP 1 1 \u0425 \u0425", "type": "Table"}, {"bbox": [41.130322265625, 81.8380078125, 418.005322265625, 85.96219468417357], "text": "Table 6: El From 1 Togramming modes", "type": "TableCell"}, {"bbox": [39.630322265625, 85.96219468417357, 100.755322265625, 97.58490314070815], "text": "Mode", "type": "TableCell"}, {"bbox": [100.755322265625, 85.96219468417357, 139.755322265625, 97.58490314070815], "text": "RST", "type": "TableCell"}, {"bbox": [139.755322265625, 85.96219468417357, 184.380322265625, 97.58490314070815], "text": "PSEN", "type": "TableCell"}, {"bbox": [184.380322265625, 85.96219468417357, 224.130322265625, 97.58490314070815], "text": "ALE", "type": "TableCell"}, {"bbox": [224.130322265625, 85.96219468417357, 264.255322265625, 97.58490314070815], "text": "EA", "type": "TableCell"}, {"bbox": [263.880322265625, 85.96219468417357, 303.255322265625, 97.58490314070815], "text": "P2.7", "type": "TableCell"}, {"bbox": [303.255322265625, 85.96219468417357, 343.005322265625, 97.58490314070815], "text": "P2.6", "type": "TableCell"}, {"bbox": [343.005322265625, 85.96219468417357, 382.755322265625, 97.58490314070815], "text": "P2.5", "type": "TableCell"}, {"bbox": [382.755322265625, 85.96219468417357, 418.380322265625, 97.58490314070815], "text": "P2.4", "type": "TableCell"}, {"bbox": [40.005322265625, 97.58490314070815, 100.755322265625, 109.5825376764858], "text": "Program", "type": "TableCell"}, {"bbox": [100.755322265625, 97.58490314070815, 139.755322265625, 109.5825376764858], "text": "1", "type": "TableCell"}, {"bbox": [139.755322265625, 97.58490314070815, 184.380322265625, 109.5825376764858], "text": "0", "type": "TableCell"}, {"bbox": [184.380322265625, 97.58490314070815, 224.130322265625, 109.5825376764858], "text": "0*", "type": "TableCell"}, {"bbox": [224.130322265625, 97.58490314070815, 264.255322265625, 109.5825376764858], "text": "VPP", "type": "TableCell"}, {"bbox": [263.880322265625, 97.58490314070815, 303.255322265625, 109.5825376764858], "text": "1", "type": "TableCell"}, {"bbox": [303.255322265625, 97.58490314070815, 343.005322265625, 109.5825376764858], "text": "0", "type": "TableCell"}, {"bbox": [343.005322265625, 97.58490314070815, 382.755322265625, 109.5825376764858], "text": "\u0425", "type": "TableCell"}, {"bbox": [382.755322265625, 97.58490314070815, 418.755322265625, 109.5825376764858], "text": "\u0425", "type": "TableCell"}, {"bbox": [40.380322265625, 109.5825376764858, 100.755322265625, 121.58017221226345], "text": "Verify", "type": "TableCell"}, {"bbox": [100.755322265625, 109.5825376764858, 139.755322265625, 121.58017221226345], "text": "1", "type": "TableCell"}, {"bbox": [139.755322265625, 109.5825376764858, 184.380322265625, 121.58017221226345], "text": "0", "type": "TableCell"}, {"bbox": [184.380322265625, 109.5825376764858, 224.130322265625, 121.58017221226345], "text": "1", "type": "TableCell"}, {"bbox": [224.130322265625, 109.5825376764858, 264.255322265625, 121.58017221226345], "text": "1", "type": "TableCell"}, {"bbox": [263.880322265625, 109.5825376764858, 303.255322265625, 121.58017221226345], "text": "0", "type": "TableCell"}, {"bbox": [303.255322265625, 109.5825376764858, 343.005322265625, 121.58017221226345], "text": "0", "type": "TableCell"}, {"bbox": [343.005322265625, 109.5825376764858, 382.755322265625, 121.58017221226345], "text": "\u0425", "type": "TableCell"}, {"bbox": [382.755322265625, 109.5825376764858, 418.005322265625, 121.58017221226345], "text": "\u0425", "type": "TableCell"}, {"bbox": [40.005322265625, 121.58017221226345, 100.755322265625, 132.827954589555], "text": "Security Set", "type": "TableCell"}, {"bbox": [100.755322265625, 121.58017221226345, 139.755322265625, 132.827954589555], "text": "1", "type": "TableCell"}, {"bbox": [139.755322265625, 121.58017221226345, 184.380322265625, 132.827954589555], "text": "0", "type": "TableCell"}, {"bbox": [184.380322265625, 121.58017221226345, 224.130322265625, 132.827954589555], "text": "0*", "type": "TableCell"}, {"bbox": [224.130322265625, 121.58017221226345, 264.255322265625, 132.827954589555], "text": "VPP", "type": "TableCell"}, {"bbox": [263.880322265625, 121.58017221226345, 303.255322265625, 132.827954589555], "text": "1", "type": "TableCell"}, {"bbox": [303.255322265625, 121.58017221226345, 343.005322265625, 132.827954589555], "text": "1", "type": "TableCell"}, {"bbox": [343.005322265625, 121.58017221226345, 382.755322265625, 132.827954589555], "text": "\u0425", "type": "TableCell"}, {"bbox": [382.755322265625, 121.58017221226345, 418.380322265625, 132.827954589555], "text": "\u0425", "type": "TableCell"}, {"bbox": [35.25, 134.6630859375, 57.75, 141.63829787234042], "text": "NOTE:", "type": "SectionHeader"}, {"bbox": [35.25, 142.38770685579195, 126.0, 159.6241134751773], "text": "\"1\" = logic high for that pin \"0\" = logic low for that pin", "type": "Text"}, {"bbox": [35.25, 158.8095703125, 99.0, 165.6201171875], "text": "\"X\" = \"don't care\"", "type": "Text"}, {"bbox": [238.4033203125, 141.783203125, 315.0, 149.212890625], "text": "\"VPP\" = +21V + 0.5V", "type": "Text"}, {"bbox": [236.5869140625, 149.83203125, 333.0, 157.37588652482268], "text": "*Al F is pulsed low for 50 ms.", "type": "Text"}, {"bbox": [35.25, 176.455078125, 168.0, 185.85342789598107], "text": "PROGRAMMING THE 8751H", "type": "SectionHeader"}, {"bbox": [34.5, 192.552734375, 222.75, 311.427734375], "text": "To be programmed, the part must be running with a 4 to 6 MHz oscillator. (The reason the oscillator needs to be running is that the internal bus is being used to transfer address and program data to appropriate internal registers.) The address of an EPROM location to be programmed is applied to Port 1 and pins P2.0\u2013P2.3 of Port 2, while the code byte to be programmed into that location is applied to Port 0. The other Port 2 pins, and RST, PSEN, and EA/Vpp should be held at the \"Program\" levels indicated in Table 3. ALE/PROG is pulsed low for 50 ms to program the code byte into the addressed EPROM location. The setup is shown in Figure 5.", "type": "Text"}, {"bbox": [35.25, 319.9976359338061, 222.75, 373.0322265625], "text": "Normally EA/Vpp is held at a logic high until just before ALE/PROG is to be pulsed. Then EA/Vpp is raised to +21V, ALE/PROG is pulsed, and then EA/Vpp is returned to a logic high. Waveforms and detailed timing specifications are shown in later sections of this data sheet.", "type": "Text"}, {"bbox": [30.23974609375, 375.19921875, 224.96533203125, 568.37109375], "text": "", "type": "FigureGroup"}, {"bbox": [30.23974609375, 375.19921875, 224.96533203125, 560.94140625], "text": "", "type": "Figure"}, {"bbox": [58.5, 559.8085106382979, 200.25, 568.37109375], "text": "Figure 5. Programming Configuration", "type": "Caption"}, {"bbox": [237.75, 173.0498046875, 425.25, 227.0709219858156], "text": "Note that the EA/VPP pin must not be allowed to go above the maximum specified VPP level of 21.5V for any amount of time. Even a narrow glitch above that voltage level can cause permanent damage to the device. The VPP source should be well regulated and free of glitches.", "type": "Text"}, {"bbox": [237.26806640625, 243.6318359375, 338.25, 254.1572265625], "text": "Program Verification", "type": "SectionHeader"}, {"bbox": [237.26806640625, 260.3486328125, 426.0, 349.22458628841605], "text": "If the Security Bit has not been programmed, the onchip Program Memory can be read out for verification purposes, if desired, either during or after the programming operation. The address of the Program Memory location to be read is applied to Port 1 and pins P2.0\u2013P2.3. The other pins should be held at the \"Verify\" levels indicated in Table 3. The contents of the addressed location will come out on Port 0. External pullups are required on Port 0 for this operation.", "type": "Text"}, {"bbox": [238.5, 357.86328125, 425.25, 392.6903073286052], "text": "The setup, which is shown in Figure 6, is the same as for programming the EPROM except that pin P2.7 is held at a logic low, or may be used as an active-low read strobe.", "type": "Text"}, {"bbox": [234.29638671875, 399.345703125, 427.78369140625, 579.2931442080378], "text": "", "type": "FigureGroup"}, {"bbox": [234.29638671875, 399.345703125, 427.78369140625, 571.466796875], "text": "", "type": "Figure"}, {"bbox": [274.5, 571.0496453900709, 389.39208984375, 579.2931442080378], "text": "Figure 6. Program Verification", "type": "Caption"}, {"bbox": [36.55517578125, 613.8779296875, 46.5, 621.2600472813239], "text": "", "type": "PageFooter"}], "doc_id": "DSA-278777.pdf", "page_index": 13, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/DSA-278777.pdf", "source": "marker"}
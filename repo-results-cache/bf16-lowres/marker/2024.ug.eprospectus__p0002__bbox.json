{"blocks": [{"bbox": [0.0, 0.0, 1191.0, 842.0], "text": "", "type": "Page"}, {"bbox": [33.14794921875, 23.845703125, 241.34033203125, 354.396484375], "text": "TOP 100 REASONS WHY NTU SMART CAMPUS IS FOR YOU", "type": "SectionHeader"}, {"bbox": [35.47412109375, 391.3984375, 287.86376953125, 470.3359375], "text": "", "type": "Figure"}, {"bbox": [37.80029296875, 463.7578125, 287.86376953125, 587.09765625], "text": "", "type": "Picture"}, {"bbox": [29.3369140625, 593.9224609375, 298.6533203125, 733.2142578125], "text": "", "type": "Picture"}, {"bbox": [50.0126953125, 735.927734375, 184.9306640625, 745.794921875], "text": "Immersion in Research", "type": "SectionHeader"}, {"bbox": [47.25, 750.527159394479, 278.25, 788.7658058771149], "text": "Realise your passion for research with over 200 industry collaborators including those with labs on campus such as Delta Electronics, Saab and Rolls-Royce.", "type": "Text"}, {"bbox": [328.5, 50.984861976847725, 483.0, 67.8369140625], "text": "Interdisciplinary Learning", "type": "SectionHeader"}, {"bbox": [326.8271484375, 65.2306322350846, 525.75, 92.09375], "text": "Learn across disciplines, acquire multiple skills and develop versatility for new career demands.", "type": "Text"}, {"bbox": [291.03125, 92.09375, 558.021484375, 302.59375], "text": "", "type": "Picture"}, {"bbox": [312.28857421875, 312.0498046875, 422.25, 329.3173828125], "text": "Space to Innovate", "type": "SectionHeader"}, {"bbox": [312.0, 330.65182546749776, 462.75, 368.7861328125], "text": "Explore, experiment and exchange ideas in multidisciplinary teams and make amazing new discoveries.", "type": "Text"}, {"bbox": [298.39111328125, 368.7861328125, 550.66162109375, 562.0185546875], "text": "", "type": "Picture"}, {"bbox": [298.6533203125, 564.98828125, 557.3779296875, 801.6171875], "text": "", "type": "Picture"}, {"bbox": [676.916015625, 48.513671875, 781.59375, 68.248046875], "text": "Global Exposure", "type": "SectionHeader"}, {"bbox": [678.0791015625, 65.230
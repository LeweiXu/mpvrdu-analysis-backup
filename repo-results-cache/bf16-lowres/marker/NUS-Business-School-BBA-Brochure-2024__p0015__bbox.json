{"blocks": [{"bbox": [0.0, 0.0, 497.0, 667.0], "text": "", "type": "Page"}, {"bbox": [39.0392749244713, 53.08642578125, 213.21450151057402, 63.023622047244096], "text": "BUSINESS SCHOOL BIZCAREERS", "type": "SectionHeader"}, {"bbox": [33.03323262839879, 80.44384765625, 234.98640483383687, 167.31271091113612], "text": "NUS Business School students are highly sought after by global and local companies. Our BIZCareers team works closely with students to help them achieve their career objectives, while actively engaging and fostering close partnerships with recruiters across the major industries to bring meaningful opportunities to our students.", "type": "Text"}, {"bbox": [31.79052734375, 179.31721034870642, 176.4274924471299, 253.70751953125003], "text": "", "type": "ListGroup"}, {"bbox": [31.79052734375, 179.31721034870642, 140.39123867069486, 188.896484375], "text": "Alumni Sharing Sessions", "type": "ListItem"}, {"bbox": [32.27587890625, 190.57142857142858, 142.64350453172204, 199.9697265625], "text": "Booster Skills Workshops", "type": "ListItem"}, {"bbox": [32.033203125, 201.0753655793026, 103.60422960725076, 210.3916015625], "text": "Company Visits", "type": "ListItem"}, {"bbox": [32.28247734138973, 212.32958380202476, 153.15407854984895, 220.8134765625], "text": "Career &amp; Recruitment Talks", "type": "ListItem"}, {"bbox": [32.28247734138973, 222.83352080989877, 141.14199395770393, 232.21240234375003], "text": "Career &amp; Internship Fairs", "type": "ListItem"}, {"bbox": [32.28247734138973, 233.84082031250003, 176.4274924471299, 243.09111361079866], "text": "Internship &amp; Job Search Briefings", "type": "ListItem"}, {"bbox": [32.28247734138973, 245.23974609375003, 146.39728096676737, 253.70751953125003], "text": "Industry Awareness Series", "type": "ListItem"}, {"bbox": [238.574560546875, 23.514355468750004, 497.0, 194.04228515625], "text": "", "type": "Picture"}, {"bbox": [253.0045317220544, 200.94677734375, 445.1978851963746, 252.40478515625003], "text": "", "type": "ListGroup"}, {"bbox": [253.0045317220544, 200.94677734375, 398.6510574018127, 210.71728515625], "text": "Industry Specific Skills Workshops", "type": "ListItem"}, {"bbox": [253.75528700906347, 211.5793025871766, 403.90634441087616, 222.1162109375], "text": "Individual Career Advisory sessions", "type": "ListItem"}, {"bbox": [253.0045317220544, 222.83352080989877, 402.404833836858, 231.56103515625003], "text": "Individual Mock Interview sessions", "type": "ListItem"}, {"bbox": [253.0045317220544, 233.3374578177728, 445.1978851963746, 243.61132812500003], "text": "Individual Internship &amp; Job Search Strategies", "type": "ListItem"}, {"bbox": [253.0045317220544, 244.59167604049495, 319.07099697885195, 252.40478515625003], "text": "Career Guides", "type": "ListItem"}, {"bbox": [37.857421875, 280.6051743532059, 112.61329305135952, 290.83544921875], "text": "INTERNSHIPS", "type": "SectionHeader"}, {"bbox": [33.00390625, 308.0966796875, 234.98640483383687, 351.0869140625], "text": "Internships are a crucial part of university education. Students are encouraged to embark on internships with many taking up at least two internships during their time at NUS.", "type": "Text"}, {"bbox": [32.76123046875, 363.88638920134986, 239.03564453125, 415.89794921875], "text": "At NUS Business School, an internship will be a graduation requirement for students under the new curriculum. Students will gain real world industry experience, with the option to obtain units or not.", "type": "Text"}, {"bbox": [33.03323262839879, 428.599609375, 158.40936555891238, 437.41394825646796], "text": "Credit-bearing Internships:", "type": "SectionHeader"}, {"bbox": [30.480078125, 444.03701171875, 64.648828125, 476.99619140625003], "text": "", "type": "Picture"}, {"bbox": [66.81722054380666, 453.35156250000006, 99.85045317220545, 461.16796875000006], "text": "BI3704", "type": "SectionHeader"}, {"bbox": [66.81722054380666, 465.1743532058493, 142.64350453172204, 474.177727784027], "text": "8-week internship", "type": "Text"}, {"bbox": [28.87841796875, 479.56909179687506, 66.25048828125, 511.81176757812506], "text": "", "type": "Picture"}, {"bbox": [67.94921875, 488.52539062500006, 98.041015625, 496.34179687500006], "text": "BI3708", "type": "SectionHeader"}, {"bbox": [68.31873111782477, 500.43757030371205, 147.8987915407855, 508.71777343750006], "text": "16-week internship", "type": "Text"}, {"bbox": [30.91689453125, 517.12041015625, 66.15341796875, 547.21357421875], "text": "", "type": "Picture"}, {"bbox": [66.81722054380666, 523.6962879640046, 99.85045317220545, 533.4697265625], "text": "BI3712", "type": "SectionHeader"}, {"bbox": [67.56797583081571, 534.9505061867267, 147.8987915407855, 543.9538807649044], "text": "24-week internship", "type": "Text"}, {"bbox": [30.480078125, 549.981884765625, 64.648828125, 580.791552734375], "text": "", "type": "Picture"}, {"bbox": [66.81722054380666, 559.7097862767155, 99.85045317220545, 567.66650390625], "text": "BI3003", "type": "SectionHeader"}, {"bbox": [66.81722054380666, 570.2137232845895, 196.6978851963746, 594.37255859375], "text": "8-week internship (for non-business/accounting/real estate related internships)", "type": "Text"}, {"bbox": [30.72275390625, 610.3310546875, 48.87490234375, 624.6611328125], "text": "", "type": "Picture"}, {"bbox": [52.55287009063444, 609.9786276715411, 235.73716012084594, 624.9842519685039], "text": "https://bba.nus.edu.sg/academic-programmes/general-academic-matters/business-internship-courses/", "type": "Text"}, {"bbox": [259.761329305136, 280.6051743532059, 413.51953125, 303.537109375], "text": "CAREER COMPASS STARTER WORKSHOPS", "type": "SectionHeader"}, {"bbox": [253.75528700906347, 320.79833984375, 450.4531722054381, 386.58642578125], "text": "Unlock your future potential with the Career Compass Starter Workshops as we guide you in cultivating the skills essential for your career. Tailored to your needs, we are here to support you on your journey, empowering you to achieve your unique career goals .", "type": "Text"}, {"bbox": [253.75528700906347, 398.3993250843645, 280.7824773413897, 406.65241844769406], "text": "Year 1", "type": "SectionHeader"}, {"bbox": [252.62548828125, 409.65354330708664, 417.41993957703926, 472.6771653543307], "text": "", "type": "ListGroup"}, {"bbox": [252.62548828125, 409.65354330708664, 364.86706948640483, 418.65691788526436], "text": "Strategic Career Planning", "type": "ListItem"}, {"bbox": [253.0045317220544, 420.15748031496065, 386.6389728096677, 429.1608548931384], "text": "Resume &amp; Cover letter Writing", "type": "ListItem"}, {"bbox": [253.0045317220544, 431.205078125, 337.0891238670695, 439.6647919010124], "text": "Personal Branding", "type": "ListItem"}, {"bbox": [253.0045317220544, 442.2783203125, 333.33534743202415, 450.1687289088864], "text": "Networking Skills", "type": "ListItem"}, {"bbox": [253.0045317220544, 453.169853768279, 335.5876132930514, 461.81933593750006], "text": "Interviewing Skills", "type": "ListItem"}, {"bbox": [253.0045317220544, 463.673790776153, 417.41993957703926, 472.6771653543307], "text": "Dealing with Others in the Workplace", "type": "ListItem"}, {"bbox": [253.0045317220544, 485.4319460067492, 381.3836858006042, 494.4353205849269], "text": "Year 2 (led by Career Advisors)", "type": "Text"}, {"bbox": [253.0045317220544, 495.9358830146232, 406.15861027190334, 515.4431946006749], "text": "", "type": "ListGroup"}, {"bbox": [253.0045317220544, 495.9358830146232, 375.37764350453176, 504.9392575928009], "text": "Small Group Resume Clinics", "type": "ListItem"}, {"bbox": [253.0045317220544, 506.4398200224972, 406.15861027190334, 515.4431946006749], "text": "Small Group Mock Interview Clinics", "type": "ListItem"}, {"bbox": [241.316796875, 519.172216796875, 474.09140625, 654.591455078125], "text": "", "type": "Picture"}, {"bbox": [33.00390625, 638.4893138357705, 45.04531722054381, 646.7424071991002], "text": "", "type": "PageFooter"}], "doc_id": "NUS-Business-School-BBA-Bro
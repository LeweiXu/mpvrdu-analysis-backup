{"blocks": [{"bbox": [0.0, 0.0, 768.0, 576.0], "text": "", "type": "Page"}, {"bbox": [264.0, 27.84375, 505.5, 61.03125], "text": "Engine Sensors", "type": "SectionHeader"}, {"bbox": [30.75, 74.25, 701.25, 132.75], "text": "Oxygen Sensor measures the oxygen content in engine exhaust.", "type": "Text"}, {"bbox": [24.75, 153.0, 487.5, 209.25], "text": "Mounted on the exhaust system before the catalytic converter.", "type": "Text"}, {"bbox": [26.25, 252.0, 483.0, 306.28125], "text": "Voltage out-put of O2 sensor changes with the change in oxygen content of exhaust.", "type": "Text"}, {"bbox": [26.25, 355.5, 415.5, 408.65625], "text": "", "type": "ListGroup"}, {"bbox": [26.25, 355.5, 415.5, 376.875], "text": "Lean mixture decreases the voltage.", "type": "ListItem"}, {"bbox": [26.25, 385.59375, 402.75, 408.65625], "text": "Rich mixture increases the voltage.", "type": "ListItem"}, {"bbox": [25.5, 468.75, 744.75, 523.6875], "text": "Signal is sent to ECM and the ECM changes the time that an injector is open or close.", "type": "Text"}], "doc_id": "efis-140411041451-phpapp01_95.pdf", "page_index": 22, "pdf_path": "/mmfs1/data/group/ems036/lxu/mpvrdu/.data/mmlongbench/documents/efis-140411041451-phpapp01_95.pdf", "source": "marker"}